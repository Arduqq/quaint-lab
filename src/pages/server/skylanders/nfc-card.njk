---
title: "Skylanders Card Maker"
layout: blank.njk
permalink: "/server/skylanders/nfc-card/"
---

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@600;700&family=Comic+Neue:wght@400;700&family=Caveat:wght@400;700&family=Orbitron:wght@400;700;900&family=Jost:wght@400;600;700&family=Cabin:wght@400;600;700&family=Fredoka:wght@400;600;700&family=Boogaloo&family=Righteous&family=Creepster&display=swap" rel="stylesheet">

<style>
  @font-face {
    font-family: 'Critters';
    src: url('/fonts/critters.woff');
  }

  body {
    background: url(/images/ui/clouds.png) repeat;
    background-color: #004a99;
    margin: 0;
    min-height: 100vh;
    font-family: 'Atkinson Hyperlegible', sans-serif;
    color: #fff;
  }
  .wrapper { max-width: none !important; padding: 0 !important; }
  #main-content { padding: 0 !important; }

  .nfc-wrap { max-width: 1200px; margin: 0 auto; padding: 24px 20px 60px; }

  .nfc-header {
    text-align: center; padding: 24px 24px 20px;
    background: rgba(0, 20, 60, 0.75);
    border: 1px solid rgba(255, 204, 0, 0.3);
    border-radius: 12px;
    margin-bottom: 18px;
  }
  .nfc-header h1 { color: #ffcc00; font-size: 1.7rem; margin: 0 0 5px; text-transform: uppercase; letter-spacing: 2px; }
  .nfc-header p { opacity: .65; max-width: 500px; margin: 0 auto 12px; font-size: .88rem; line-height: 1.5; }
  .nfc-back { color: #99ccff; font-size: .82rem; text-decoration: none; }
  .nfc-back:hover { color: #fff; }

  .nfc-layout {
    display: grid;
    grid-template-columns: 250px 1fr 300px;
    gap: 14px;
    align-items: start;
  }

  .nfc-panel {
    background: rgba(0, 20, 60, 0.75);
    border: 1px solid rgba(255, 204, 0, 0.2);
    border-radius: 10px;
    overflow: hidden;
  }
  .panel-title {
    background: rgba(0, 0, 0, 0.35);
    border-bottom: 1px solid rgba(255, 204, 0, 0.15);
    padding: 9px 13px;
    font-size: .68rem; font-weight: bold;
    text-transform: uppercase; letter-spacing: 1.5px;
    color: #ffcc00;
  }
  .panel-body { padding: 10px 12px; }

  .nfc-search {
    width: 100%; box-sizing: border-box;
    background: rgba(0,0,0,.35);
    border: 1px solid rgba(255,204,0,.22);
    border-radius: 5px;
    color: #fff; padding: 6px 9px;
    font-family: inherit; font-size: .82rem;
    margin-bottom: 7px;
  }
  .nfc-search::placeholder { color: rgba(255,255,255,.3); }
  .nfc-search:focus { outline: none; border-color: rgba(255,204,0,.65); }

  .elem-filters { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 7px; }
  .elem-btn {
    background: rgba(0,0,0,.25);
    border: 1px solid rgba(255,255,255,.14);
    border-radius: 4px; padding: 3px; cursor: pointer;
    transition: background .12s, border-color .12s; line-height: 0;
  }
  .elem-btn img { width: 19px; height: 19px; object-fit: contain; image-rendering: pixelated; }
  .elem-btn.active { background: rgba(255,204,0,.2); border-color: #ffcc00; }
  .elem-btn-clear {
    background: rgba(0,0,0,.25); border: 1px solid rgba(255,255,255,.14);
    border-radius: 4px; padding: 2px 6px; cursor: pointer;
    color: rgba(255,255,255,.45); font-size: .68rem;
    transition: color .12s; font-family: inherit;
  }
  .elem-btn-clear:hover { color: #fff; }

  .char-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 4px; max-height: 500px; overflow-y: auto; padding-right: 2px;
  }
  .char-grid::-webkit-scrollbar { width: 4px; }
  .char-grid::-webkit-scrollbar-track { background: rgba(0,0,0,.2); border-radius: 2px; }
  .char-grid::-webkit-scrollbar-thumb { background: rgba(255,204,0,.3); border-radius: 2px; }

  .char-thumb {
    aspect-ratio: 1; background: rgba(0,0,0,.3);
    border: 1.5px solid rgba(80,120,180,.22);
    border-radius: 5px; cursor: pointer; overflow: hidden;
    transition: border-color .12s, background .12s;
  }
  .char-thumb:hover { border-color: rgba(255,204,0,.5); background: rgba(0,60,120,.4); }
  .char-thumb.selected { border-color: #ffcc00; background: rgba(0,80,160,.55); box-shadow: 0 0 0 1px #ffcc00; }
  .char-thumb img { width: 100%; height: 100%; object-fit: contain; display: block; pointer-events: none; }
  .char-no-results { grid-column: span 4; text-align: center; padding: 20px; opacity: .4; font-size: .78rem; }

  .panel-preview { position: sticky; top: 14px; }
  .canvas-outer {
    padding: 12px; display: flex; justify-content: center; align-items: flex-start;
    background: rgba(0,0,0,.25);
    border-bottom: 1px solid rgba(255,204,0,.1);
  }
  #card-canvas { width: auto; height: auto; max-width: 100%; display: block; border-radius: 4px; touch-action: none; }

  .preview-actions {
    padding: 11px; display: flex; flex-direction: column; align-items: center; gap: 7px;
  }
  .nfc-btn {
    background: rgba(255,204,0,.15); border: 2px solid rgba(255,204,0,.45);
    color: #ffcc00; font-family: inherit; font-weight: bold; font-size: .88rem;
    padding: 8px 20px; border-radius: 7px; cursor: pointer;
    transition: background .12s; width: 100%; max-width: 260px;
  }
  .nfc-btn:hover { background: rgba(255,204,0,.3); border-color: #ffcc00; }
  .nfc-btn:disabled { opacity: .32; cursor: default; }
  .size-note { font-size: .7rem; opacity: .38; text-align: center; }

  .opt-section { padding: 10px 13px; border-bottom: 1px solid rgba(255,255,255,.055); }
  .opt-section:last-child { border-bottom: none; }
  .opt-label { font-size: .66rem; text-transform: uppercase; letter-spacing: 1.2px; color: #ffcc00; margin-bottom: 7px; display: block; }

  .bg-swatches { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; }
  .bg-swatches.cols3 { grid-template-columns: 1fr 1fr 1fr; }
  .bg-swatch {
    border: 2px solid rgba(255,255,255,.14); border-radius: 5px;
    cursor: pointer; padding: 5px 7px; font-size: .72rem;
    font-family: inherit; color: #fff; text-align: center;
    transition: border-color .12s; font-weight: bold;
  }
  .bg-swatch:hover { border-color: rgba(255,204,0,.5); }
  .bg-swatch.active { border-color: #ffcc00; }

  .nfc-input {
    width: 100%; box-sizing: border-box;
    background: rgba(0,0,0,.35); border: 1px solid rgba(255,255,255,.18);
    border-radius: 5px; color: #fff; padding: 6px 8px;
    font-family: inherit; font-size: .82rem; margin-bottom: 4px;
  }
  .nfc-input:focus { outline: none; border-color: rgba(255,204,0,.6); }
  textarea.nfc-input { resize: vertical; min-height: 60px; line-height: 1.4; }

  .toggle-row {
    display: flex; align-items: center; gap: 7px;
    font-size: .8rem; color: rgba(255,255,255,.7);
    cursor: pointer; user-select: none; margin-top: 4px;
  }
  .toggle-row input[type="checkbox"] { accent-color: #ffcc00; width: 13px; height: 13px; cursor: pointer; }

  .bg-color-row {
    display: flex; align-items: center; gap: 9px; margin-top: 8px;
    font-size: .78rem; color: rgba(255,255,255,.7); cursor: pointer; user-select: none;
  }
  .bg-color-row input[type="color"] {
    width: 40px; height: 26px; padding: 0; border: 1px solid rgba(255,255,255,.18);
    border-radius: 5px; background: transparent; cursor: pointer;
  }
  .bg-color-row input[type="range"] { accent-color: #ffcc00; cursor: pointer; }

  .attack-fields { margin-top: 8px; }
  .attack-fields.hidden { display: none; }

  .upload-label {
    display: block; text-align: center;
    background: rgba(0,0,0,.3); border: 1px dashed rgba(255,204,0,.35);
    border-radius: 5px; padding: 8px; cursor: pointer;
    font-size: .78rem; color: rgba(255,204,0,.7);
    transition: border-color .12s, color .12s; margin-bottom: 5px;
  }
  .upload-label:hover { border-color: #ffcc00; color: #ffcc00; }
  .upload-label input { display: none; }

  .clear-btn {
    background: transparent; border: 1px solid rgba(255,255,255,.18);
    border-radius: 5px; color: rgba(255,255,255,.45); font-family: inherit;
    font-size: .72rem; padding: 4px 10px; cursor: pointer; width: 100%;
    transition: color .12s, border-color .12s;
  }
  .clear-btn:hover { color: #fff; border-color: rgba(255,255,255,.4); }
  .custom-indicator { font-size: .7rem; color: #ffcc00; margin-top: 3px; text-align: center; display: none; }

  /* Archive image picker */
  .arc-tabs { display: flex; gap: 4px; margin-bottom: 8px; }
  .arc-tab {
    flex: 1; background: rgba(0,0,0,.3); border: 1px solid rgba(255,255,255,.14);
    border-radius: 5px; color: rgba(255,255,255,.5); font-size: .72rem;
    font-family: inherit; padding: 4px 0; cursor: pointer; transition: all .12s;
  }
  .arc-tab:hover { color: #fff; border-color: rgba(255,255,255,.35); }
  .arc-tab.active { background: rgba(255,204,0,.15); border-color: #ffcc00; color: #ffcc00; }
  .arc-gallery {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px;
    max-height: 220px; overflow-y: auto; padding-right: 2px;
  }
  .arc-gallery::-webkit-scrollbar { width: 4px; }
  .arc-gallery::-webkit-scrollbar-track { background: rgba(0,0,0,.2); border-radius: 2px; }
  .arc-gallery::-webkit-scrollbar-thumb { background: rgba(255,204,0,.3); border-radius: 2px; }
  .arc-thumb {
    aspect-ratio: 1; background: rgba(0,0,0,.35); border: 1.5px solid rgba(255,255,255,.1);
    border-radius: 4px; overflow: hidden; cursor: pointer; padding: 0;
    transition: border-color .12s;
  }
  .arc-thumb:hover { border-color: rgba(255,204,0,.5); }
  .arc-thumb.selected { border-color: #ffcc00; box-shadow: 0 0 0 1px #ffcc00; }
  .arc-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }
  .arc-empty { font-size: .72rem; color: rgba(255,255,255,.35); line-height: 1.5; padding: 6px 0; }
  .arc-status-msg { font-size: .68rem; color: rgba(255,255,255,.3); display: block; margin-top: 3px; }

  /* Card-art paging: a tight wrapper hugging the canvas's rendered box, so the
     prev/next arrows can be anchored to the actual card edges rather than the
     wider flex container (see pageArchiveArt). Hidden until a character with
     multiple tagged archive images is selected. */
  .canvas-frame { position: relative; display: inline-block; line-height: 0; }
  .browse-arrows { display: none; }
  .browse-arrows.show { display: block; }
  .browse-arr {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 5;
    display: flex; align-items: center; justify-content: center; padding: 0;
    width: 36px; height: 36px; border-radius: 50%;
    background: rgba(8,8,16,.74); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px);
    border: 1.5px solid rgba(255,204,0,.55); color: #ffe9a8;
    box-shadow: 0 2px 12px rgba(0,0,0,.55), inset 0 0 0 1px rgba(0,0,0,.35);
    font-size: 1.3rem; line-height: 1; cursor: pointer;
    font-family: inherit; transition: background .15s, border-color .15s, color .15s, transform .15s;
  }
  .browse-arr:hover { background: rgba(255,204,0,.3); border-color: #ffcc00; color: #fff; transform: translateY(-50%) scale(1.08); }
  .browse-arr.prev { left: 14px; }
  .browse-arr.next { right: 14px; }

  @media (max-width: 960px) {
    .nfc-layout { grid-template-columns: 1fr 1fr; }
    .panel-preview { grid-column: span 2; order: -1; position: static; }
    #card-canvas { max-height: 480px; }
  }
  @media (max-width: 580px) {
    .nfc-layout { grid-template-columns: 1fr; }
    .panel-preview { grid-column: 1; }
  }
</style>

<div class="nfc-wrap">
  <header class="nfc-header">
    <h1>Skylanders Card Maker</h1>
    <p>Build a custom NFC card for any Skylander and export a print-ready PNG at exactly 54 × 85.6 mm — standard NFC card size, ready for Cricut.</p>
    <a href="/server/skylanders/" class="nfc-back">← Back to Collection</a>
  </header>

  <div class="nfc-layout">

    <!-- Left: Character Picker -->
    <div class="nfc-panel">
      <div class="panel-title">Character</div>
      <div class="panel-body">
        <input type="text" id="char-search" class="nfc-search" placeholder="Search characters…" autocomplete="off">
        <div class="elem-filters" id="elem-filters">
          {% set elements = ["fire","water","earth","wind","magic","nature","undead","tech","light","dark"] %}
          {% for el in elements %}
          <button class="elem-btn" data-element="{{ el }}" title="{{ el | capitalize }}">
            <img src="/images/server/elements/{{ el }}.png" alt="{{ el }}">
          </button>
          {% endfor %}
          <button class="elem-btn-clear" id="elem-clear">✕</button>
        </div>
        <div class="char-grid" id="char-grid"></div>
      </div>
    </div>

    <!-- Center: Preview -->
    <div class="nfc-panel panel-preview">
      <div class="panel-title">
        Card Preview
        <span style="opacity:.38;font-weight:normal;text-transform:none;letter-spacing:0"> — 54 × 85.6 mm @ 300 DPI</span>
      </div>
      <div class="canvas-outer">
        <div class="canvas-frame">
          <canvas id="card-canvas" width="638" height="1011"></canvas>
          <div class="browse-arrows" id="browse-arrows">
            <button class="browse-arr prev" id="browse-prev" aria-label="Previous image" type="button">‹</button>
            <button class="browse-arr next" id="browse-next" aria-label="Next image" type="button">›</button>
          </div>
        </div>
      </div>
      <div class="preview-actions">
        <button class="clear-btn" id="reset-art-btn" style="max-width:260px">↺ Reset position</button>
        <button class="nfc-btn" id="export-btn" disabled>↓ Export PNG</button>
        <span class="size-note">638 × 1011 px · transparent rounded corners · Cricut-ready</span>
      </div>
    </div>

    <!-- Right: Style + Attack -->
    <div class="nfc-panel">
      <div class="panel-title">Style &amp; Attack</div>

      <div class="opt-section">
        <span class="opt-label">Card Layout</span>
        <div class="bg-swatches cols3">
          <button class="bg-swatch active" data-layout="half"
            style="background:rgba(0,0,0,.35)">Half Image</button>
          <button class="bg-swatch" data-layout="quarter"
            style="background:rgba(0,0,0,.35)">Quarter Image</button>
          <button class="bg-swatch" data-layout="full"
            style="background:rgba(0,0,0,.35)">Full Image</button>
        </div>
      </div>

      <div class="opt-section">
        <span class="opt-label">Background</span>
        <div class="bg-swatches cols3">
          <button class="bg-swatch active" data-bg="element"
            style="background:linear-gradient(135deg,#220044,#8822CC)">Element</button>
          <button class="bg-swatch" data-bg="custom"
            style="background:linear-gradient(135deg,#222,#444)">Custom Color</button>
          <button class="bg-swatch" data-bg="transparent"
            style="background:repeating-conic-gradient(#3a3a3a 0% 25%, #232323 0% 50%) 0 0/16px 16px">Transparent</button>
        </div>
        <label class="bg-color-row" id="bg-color-row" style="display:none">
          <span>Color</span>
          <input type="color" id="bg-color-input" value="#7a1ec8">
        </label>
        <div id="arc-bg-gallery" class="arc-gallery" style="margin-top:8px"></div>
        <span id="arc-bg-status" class="arc-status-msg"></span>
        <label class="bg-color-row" id="bg-opacity-row" style="display:none">
          <span>Color tint</span>
          <input type="range" id="bg-opacity-input" min="0" max="100" value="48" style="flex:1">
          <span id="bg-opacity-value" style="min-width:32px;text-align:right">48%</span>
        </label>
      </div>

      <div class="opt-section">
        <span class="opt-label">Art Pattern</span>
        <div class="bg-swatches">
          <button class="bg-swatch" data-pattern="none"
            style="background:rgba(0,0,0,.35)">None</button>
          <button class="bg-swatch active" data-pattern="clouds"
            style="background:rgba(0,0,0,.35)">Clouds</button>
          <button class="bg-swatch" data-pattern="polka"
            style="background:rgba(0,0,0,.35)">Polka</button>
          <button class="bg-swatch" data-pattern="hex"
            style="background:rgba(0,0,0,.35)">Hex</button>
          <button class="bg-swatch" data-pattern="stars"
            style="background:rgba(0,0,0,.35)">Stars</button>
        </div>
        <div id="arc-detail-gallery" class="arc-gallery" style="margin-top:8px"></div>
        <span id="arc-detail-status" class="arc-status-msg"></span>
      </div>

      <div class="opt-section">
        <span class="opt-label">Name Font</span>
        <div class="bg-swatches cols3">
          <button class="bg-swatch active" data-font="bebas"
            style="font-family:'Bebas Neue',Impact;font-size:.95rem;letter-spacing:1px;background:rgba(0,0,0,.35)">Bebas</button>
          <button class="bg-swatch" data-font="critters"
            style="font-family:'Critters',serif;font-size:.9rem;background:rgba(0,0,0,.35)">Critters</button>
          <button class="bg-swatch" data-font="rajdhani"
            style="font-family:'Rajdhani',Arial;font-weight:700;font-size:.82rem;background:rgba(0,0,0,.35)">Rajdhani</button>
          <button class="bg-swatch" data-font="comicneue"
            style="font-family:'Comic Neue',cursive;font-weight:700;font-size:.85rem;background:rgba(0,0,0,.35)">Comic Neue</button>
          <button class="bg-swatch" data-font="caveat"
            style="font-family:'Caveat',cursive;font-weight:700;font-size:1.05rem;background:rgba(0,0,0,.35)">Caveat</button>
          <button class="bg-swatch" data-font="orbitron"
            style="font-family:'Orbitron',sans-serif;font-weight:700;font-size:.74rem;letter-spacing:.5px;background:rgba(0,0,0,.35)">Orbitron</button>
          <button class="bg-swatch" data-font="jost"
            style="font-family:'Jost',sans-serif;font-weight:600;font-size:.84rem;background:rgba(0,0,0,.35)">Jost</button>
          <button class="bg-swatch" data-font="cabin"
            style="font-family:'Cabin',sans-serif;font-weight:700;font-size:.84rem;background:rgba(0,0,0,.35)">Cabin</button>
          <button class="bg-swatch" data-font="fredoka"
            style="font-family:'Fredoka',sans-serif;font-weight:600;font-size:.84rem;background:rgba(0,0,0,.35)">Fredoka</button>
          <button class="bg-swatch" data-font="boogaloo"
            style="font-family:'Boogaloo',cursive;font-size:.86rem;background:rgba(0,0,0,.35)">Boogaloo</button>
          <button class="bg-swatch" data-font="righteous"
            style="font-family:'Righteous',sans-serif;font-size:.8rem;background:rgba(0,0,0,.35)">Righteous</button>
          <button class="bg-swatch" data-font="creepster"
            style="font-family:'Creepster',cursive;font-size:.86rem;background:rgba(0,0,0,.35)">Creepster</button>
        </div>
      </div>

      <div class="opt-section">
        <span class="opt-label">Card Name</span>
        <input type="text" id="name-input" class="nfc-input" placeholder="Uses character name">
        <label class="toggle-row">
          <input type="checkbox" id="show-name" checked> Show name
        </label>
      </div>

      <div class="opt-section">
        <span class="opt-label">Attack</span>
        <label class="toggle-row">
          <input type="checkbox" id="show-attack" checked> Show attack section
        </label>
        <div class="attack-fields" id="attack-fields">
          <input type="text" id="attack-name" class="nfc-input" style="margin-top:7px" placeholder="Attack name (e.g. FIREBALL)">
          <input type="text" id="attack-damage" class="nfc-input" placeholder="Damage (e.g. 60)">
          <textarea id="attack-desc" class="nfc-input" placeholder="Attack description…"></textarea>
          <div id="arc-attack-section" style="display:none;margin-top:10px">
            <span class="opt-label">Attack Icon</span>
            <div id="arc-attack-gallery" class="arc-gallery"></div>
            <span id="arc-attack-status" class="arc-status-msg"></span>
          </div>
        </div>
      </div>

      <div class="opt-section">
        <span class="opt-label">Badges</span>
        <label class="toggle-row"><input type="checkbox" id="show-element" checked> Element icon</label>
        <label class="toggle-row" style="margin-top:5px"><input type="checkbox" id="show-logo" checked> Skylanders logo</label>
      </div>

      <div class="opt-section">
        <span class="opt-label">Custom Image</span>
        <label class="upload-label">
          ↑ Upload custom art
          <input type="file" id="custom-img" accept="image/*">
        </label>
        <button class="clear-btn" id="clear-custom">✕ Clear custom image</button>
        <div class="custom-indicator" id="custom-indicator">Custom image active</div>
      </div>

      <div class="opt-section" id="arc-art-section" style="display:none">
        <span class="opt-label">Archive Art
          <label id="arc-show-all-label" style="font-weight:400;font-size:11px;margin-left:8px;opacity:.6;cursor:pointer">
            <input type="checkbox" id="arc-show-all" style="vertical-align:middle;margin-right:3px">show all
          </label>
        </span>
        <div id="arc-art-gallery" class="arc-gallery"></div>
        <span id="arc-art-status" class="arc-status-msg"></span>
        <button class="clear-btn" id="arc-clear" style="margin-top:6px">✕ Clear archive layers</button>
      </div>
    </div>

  </div>
</div>

<script>
const SKYLANDERS_ALL = {{ skylanders | dump | safe }};
const CHARS = SKYLANDERS_ALL.flatMap(g =>
  (g.characters || []).flatMap(c => {
    const base = {
      name:    c.name,
      image:   c.image,
      element: c.element || '',
      species: c.species || '',
      gender:  c.gender  || '',
      role:    c.role    || '',
      game:    g.game
    };
    const variants = (c.variants || []).map(v => ({ ...base, name: v.name, image: v.image }));
    return [base, ...variants];
  })
);
</script>

<script type="module">
  // ── Card dimensions (portrait NFC: 54mm × 85.6mm @ 300 DPI) ──────────────
  const CARD_W = 638, CARD_H = 1011, CORNER_R = 38;

  const DIV1_H = 9;
  const DIV3_H = 4;
  const FTR_H  = 127;
  const FTR_Y  = CARD_H - FTR_H;   // 884

  const ELEMENTS = ['fire','water','earth','wind','magic','nature','undead','tech','light','dark'];

  const ELEMENT_PALETTES = {
    fire:   { dark: '#5c1400', mid: '#7A1800', mid2: '#C83200', accent: '#FF5500', highlight: '#FF9955', text: '#FFCC99' },
    water:  { dark: '#001c4a', mid: '#002266', mid2: '#0055AA', accent: '#0099FF', highlight: '#66CCFF', text: '#AADDFF' },
    earth:  { dark: '#3d2000', mid: '#553300', mid2: '#8F5A10', accent: '#CC8833', highlight: '#FFBB66', text: '#EECC99' },
    wind:   { dark: '#002233', mid: '#003355', mid2: '#005588', accent: '#00AACC', highlight: '#44DDFF', text: '#AAEEFF' },
    magic:  { dark: '#3a0044', mid: '#5500AA', mid2: '#9900CC', accent: '#CC33FF', highlight: '#EE99FF', text: '#FFCCFF' },
    nature: { dark: '#0f3200', mid: '#143800', mid2: '#2C7200', accent: '#55AA00', highlight: '#99DD44', text: '#AAEE55' },
    undead:  { dark: '#1a1a1a', mid: '#222244', mid2: '#4444AA', accent: '#6666CC', highlight: '#9999DD', text: '#BBBBEE' },
    tech:   { dark: '#452e00', mid: '#604000', mid2: '#9A7000', accent: '#DDAA00', highlight: '#FFDD55', text: '#FFEE99' },
    light:  { dark: '#4a3a00', mid: '#7a6200', mid2: '#c8a000', accent: '#f5c800', highlight: '#fffaaa', text: '#fffff5' },
    dark:   { dark: '#08001a', mid: '#150033', mid2: '#2e0060', accent: '#6600dd', highlight: '#aa66ff', text: '#ddbbff' },
  };
  // ── Derive a full card palette (dark/mid/mid2/accent/highlight/text) from a
  // single user-picked color, the same shape as ELEMENT_PALETTES, by walking
  // its hue/saturation across a fixed lightness ramp.
  function hexToHsl(hex) {
    const r = parseInt(hex.slice(1, 3), 16) / 255, g = parseInt(hex.slice(3, 5), 16) / 255, b = parseInt(hex.slice(5, 7), 16) / 255;
    const max = Math.max(r, g, b), min = Math.min(r, g, b);
    let h = 0, s = 0; const l = (max + min) / 2;
    if (max !== min) {
      const d = max - min;
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      switch (max) {
        case r: h = (g - b) / d + (g < b ? 6 : 0); break;
        case g: h = (b - r) / d + 2; break;
        default: h = (r - g) / d + 4;
      }
      h *= 60;
    }
    return [h, s * 100, l * 100];
  }
  function hslToHex(h, s, l) {
    s /= 100; l /= 100;
    const k = n => (n + h / 30) % 12;
    const a = s * Math.min(l, 1 - l);
    const f = n => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
    const toHex = x => Math.round(x * 255).toString(16).padStart(2, '0');
    return `#${toHex(f(0))}${toHex(f(8))}${toHex(f(4))}`;
  }
  function paletteFromColor(hex) {
    const [h, s] = hexToHsl(hex);
    const sat = Math.max(s, 50);
    return {
      dark:      hslToHex(h, Math.min(sat + 10, 90), 14),
      mid:       hslToHex(h, Math.min(sat + 5, 85), 25),
      mid2:      hslToHex(h, sat, 40),
      accent:    hslToHex(h, Math.min(sat + 15, 100), 53),
      highlight: hslToHex(h, Math.max(sat - 15, 30), 75),
      text:      hslToHex(h, Math.max(sat - 25, 20), 87),
    };
  }

  // Font definitions for the name — each is a function of font-size
  const FONT_DEFS = {
    bebas:     fs => `${fs}px 'Bebas Neue', Impact, sans-serif`,
    critters:  fs => `${fs}px 'Critters', serif`,
    rajdhani:  fs => `700 ${fs}px 'Rajdhani', Arial, sans-serif`,
    comicneue: fs => `700 ${fs}px 'Comic Neue', 'Comic Sans MS', cursive`,
    caveat:    fs => `700 ${fs}px 'Caveat', cursive`,
    orbitron:  fs => `700 ${fs}px 'Orbitron', sans-serif`,
    jost:      fs => `600 ${fs}px 'Jost', sans-serif`,
    cabin:     fs => `700 ${fs}px 'Cabin', sans-serif`,
    fredoka:   fs => `600 ${fs}px 'Fredoka', sans-serif`,
    boogaloo:  fs => `${fs}px 'Boogaloo', cursive`,
    righteous: fs => `${fs}px 'Righteous', sans-serif`,
    creepster: fs => `${fs}px 'Creepster', cursive`,
  };

  const state = {
    characterName: null,
    element: null,
    species: null,
    gender: null,
    role: null,
    customName: '',
    attackName: '',
    attackDamage: '',
    attackDesc: '',
    background: 'element',
    customColor: '#7a1ec8',
    bgColorOpacity: 0.48,
    pattern: 'clouds',
    nameFont: 'bebas',
    layout: 'half',
    showName: true,
    showAttack: true,
    showElement: true,
    showLogo: true,
    artOffsetX: 0, // px, in card-canvas (638×1011) space — user pan on top of drawArtPanel's auto-fit
    artOffsetY: 0,
    artZoom: 1,    // multiplier on top of drawArtPanel's auto-fit scale
  };

  // Portal background images — drawn beneath the element gradient overlay
  const PORTAL_BG = {
    fire:   '/images/server/bg/portal-fire.png',
    earth:  '/images/server/bg/portal-earth.png',
    tech:   '/images/server/bg/portal-tech.png',
    water:  '/images/server/bg/portal-water.png',
    wind:   '/images/server/bg/portal-air.png',
    magic:  '/images/server/bg/portal-magic.png',
    nature: '/images/server/bg/portal-life.png',
  };

  let charImg = null;
  let charImgIsArt = false; // true when charImg is a painted illustration (hi-res tooltip art / custom upload), not a transparent in-game figure cutout
  let logoImg = null;
  let usingCustomImg = false;
  // {x, y, w, h} of the currently-active layout's art panel, in canvas-
  // internal (638×1011) space — set by drawArtPanel every redraw, read by
  // the pointer/wheel handlers below to hit-test where dragging/zooming is
  // allowed to start. Only one layout's drawArtPanel call runs per redraw.
  let lastArtPanelRect = null;
  const elemImgCache = {};
  const portalBgCache = {};

  // ── Archive image state ────────────────────────────────────────────────────
  // Static index generated by `npm run publish-archive` (scripts/reclassify-tumblr.mjs
  // --publish) — same shape as the curation server's /api/skylanders-index, but
  // served as a plain file alongside the synced images so this works on the live
  // site (and locally) without any server running.
  const ARCHIVE_INDEX_URL = '/images/skylanders-archive/skylanders-index.json';
  let archiveIndex  = null; // full index, loaded once
  let arcBgImg      = null; // loaded Image for background layer
  let arcDetailImg  = null; // loaded Image for detail layer
  let arcArtImg     = null; // loaded Image for character art from archive
  let arcAttackIconImg = null; // loaded Image for chosen attack-flavour icon (from the character's "attack"-tagged ability icons)
  let arcBgUrl      = null;
  let arcDetailUrl  = null;
  let arcArtUrl     = null;
  let arcAttackIconUrl = null;
  const arcImgCache = {};

  async function loadArcImg(url) {
    if (!url) return null;
    if (!arcImgCache[url]) {
      const img = new Image(); img.crossOrigin = 'anonymous';
      arcImgCache[url] = await new Promise(r => { img.onload = () => r(img); img.onerror = () => r(null); img.src = url; });
    }
    return arcImgCache[url];
  }

  async function fetchArchiveIndex() {
    if (archiveIndex) return archiveIndex;
    try {
      const res = await fetch(ARCHIVE_INDEX_URL);
      if (!res.ok) return null;
      archiveIndex = await res.json();
      return archiveIndex;
    } catch { return null; }
  }

  const canvas = document.getElementById('card-canvas');
  const ctx    = canvas.getContext('2d');

  function scaleCanvas() {
    const available = canvas.parentElement.clientWidth - 24;
    const dw = Math.min(available, 400);
    canvas.style.width  = dw + 'px';
    canvas.style.height = Math.round(dw * CARD_H / CARD_W) + 'px';
  }
  scaleCanvas();
  window.addEventListener('resize', scaleCanvas);

  // ── Image helpers ──────────────────────────────────────────────────────────
  const tryLoad = src => new Promise(resolve => {
    const img = new Image();
    img.onload  = () => resolve(img);
    img.onerror = () => resolve(null);
    img.src = src;
  });
  const tryLoadCors = src => new Promise(resolve => {
    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload  = () => resolve(img);
    img.onerror = () => resolve(null);
    img.src = src;
  });

  async function loadCharImg(name) {
    // The official painted artwork already synced from the local archive
    // ("character-art-*") is the best default — roughly 770×740 versus the
    // ~120px in-game cutouts below, which look blurry once placed on the card.
    const index = await fetchArchiveIndex();
    const charImages = (index && index.byCharacter || {})[name.toLowerCase()] || [];
    const art = charImages.find(im => im.file && im.file.startsWith('character-art-'));
    if (art) { const i = await tryLoadCors(art.url); if (i) { charImgIsArt = true; return i; } }
    charImgIsArt = false;
    const slug = name.toLowerCase().replace(/[^a-z0-9]/g, '-');
    const base = `/images/server/characters/${slug}`;
    return (await tryLoad(`${base}.png`)) || (await tryLoad(`${base}.jpg`));
  }
  async function loadElemImg(el) {
    if (!el) return null;
    if (!elemImgCache[el]) elemImgCache[el] = await tryLoad(`/images/server/elements/${el}.png`);
    return elemImgCache[el];
  }
  async function loadPortalBg(el) {
    if (!PORTAL_BG[el]) return null;
    if (!portalBgCache[el]) portalBgCache[el] = await tryLoad(PORTAL_BG[el]);
    return portalBgCache[el];
  }
  ELEMENTS.forEach(loadElemImg);
  Object.keys(PORTAL_BG).forEach(loadPortalBg);
  tryLoad('/images/server/skylanders-logo.png').then(img => { logoImg = img; });

  function getPalette() {
    if (state.background === 'custom') return paletteFromColor(state.customColor);
    return ELEMENT_PALETTES[state.element] || ELEMENT_PALETTES.magic;
  }

  // ── Canvas helpers ─────────────────────────────────────────────────────────
  function roundedRect(x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x+w, y,   x+w, y+h, r);
    ctx.arcTo(x+w, y+h, x,   y+h, r);
    ctx.arcTo(x,   y+h, x,   y,   r);
    ctx.arcTo(x,   y,   x+w, y,   r);
    ctx.closePath();
  }

  function cornerBrackets(x, y, w, h, len, thick, color) {
    ctx.save();
    ctx.strokeStyle = color; ctx.lineWidth = thick; ctx.lineCap = 'square';
    for (const [a,b,c] of [
      [[x,y+len],[x,y],[x+len,y]],
      [[x+w-len,y],[x+w,y],[x+w,y+len]],
      [[x,y+h-len],[x,y+h],[x+len,y+h]],
      [[x+w-len,y+h],[x+w,y+h],[x+w,y+h-len]],
    ]) {
      ctx.beginPath(); ctx.moveTo(...a); ctx.lineTo(...b); ctx.lineTo(...c); ctx.stroke();
    }
    ctx.restore();
  }

  function wrapText(text, x, y, maxW, lineH, maxLines) {
    const words = text.split(' ');
    let line = '', drawn = 0;
    for (const word of words) {
      const test = line ? line + ' ' + word : word;
      if (ctx.measureText(test).width > maxW && line) {
        if (maxLines && drawn >= maxLines - 1) { ctx.fillText(line + '…', x, y); return; }
        ctx.fillText(line, x, y); line = word; y += lineH; drawn++;
      } else { line = test; }
    }
    if (line) ctx.fillText(line, x, y);
  }

  function diagonalStripes(x, y, w, h, spacing, sw, color, alpha) {
    ctx.save(); ctx.globalAlpha = alpha; ctx.fillStyle = color;
    for (let ox = -h; ox < w+h; ox += spacing) {
      ctx.beginPath();
      ctx.moveTo(x+ox, y); ctx.lineTo(x+ox+h, y+h);
      ctx.lineTo(x+ox+h+sw, y+h); ctx.lineTo(x+ox+sw, y);
      ctx.closePath(); ctx.fill();
    }
    ctx.restore();
  }

  // ── Angular seam accent: a glowing sash that cuts diagonally across a flat
  // horizontal divider — its centreline rises from below the seam on one side
  // to above it on the other, so it visibly slices from one section into the
  // next rather than just glowing along the boundary. Echoes the diagonal-
  // stripe / corner-bracket geometry used elsewhere on the card.
  function drawSeamCut(y, w, color, opts = {}) {
    const { thick = 15, rise = 46, from = 0.04, to = 0.58, core = '#ffffff' } = opts;
    const x1 = w * from, x2 = w * to;
    const y1 = y + rise / 2, y2 = y - rise / 2;
    const band = (col, t) => {
      const h = t / 2;
      ctx.beginPath();
      ctx.moveTo(x1, y1 - h);
      ctx.lineTo(x2, y2 - h);
      ctx.lineTo(x2, y2 + h);
      ctx.lineTo(x1, y1 + h);
      ctx.closePath();
      const g = ctx.createLinearGradient(x1, y1, x2, y2);
      g.addColorStop(0,    col + '00');
      g.addColorStop(0.5,  col);
      g.addColorStop(1,    col + '00');
      ctx.fillStyle = g;
      ctx.fill();
    };
    ctx.save();
    ctx.shadowColor = color; ctx.shadowBlur = 20;
    band(color, thick);
    // Bright core — gives the cut a defined "edge" so it reads against any
    // palette (a warm accent alone washes out on warm card backgrounds).
    ctx.shadowBlur = 0;
    band(core, thick * 0.28);
    ctx.restore();
  }

  // ── Clean seam accent: a thin glowing accent rule with a circular badge
  // overlapping it — the badge "punches through" the divider as a focal
  // point, echoing TCG layouts where a cost/rarity emblem sits squarely on
  // the illustration seam rather than tucked away inside a panel.
  function drawAccentRule(y, w, color, opts = {}) {
    const { thick = 3, from = 0.05, to = 0.95, glow = 16 } = opts;
    const x1 = w * from, x2 = w * to;
    ctx.save();
    ctx.shadowColor = color; ctx.shadowBlur = glow;
    const g = ctx.createLinearGradient(x1, y, x2, y);
    g.addColorStop(0,    color + '00');
    g.addColorStop(0.1,  color);
    g.addColorStop(0.9,  color);
    g.addColorStop(1,    color + '00');
    ctx.fillStyle = g;
    ctx.fillRect(x1, y - thick / 2, x2 - x1, thick);
    ctx.restore();
  }

  // The element artwork is already a finished circular emblem (glyph on a
  // coloured disc) — rather than rebuild a badge shell behind it, glow it and
  // ring it in the card's accent colours so it reads as the card's focal
  // point sitting *on* the seam, not just element flavour tucked in a corner.
  function drawSeamBadge(cx, cy, r, img, color, opts = {}) {
    const { ring = '#ffffff' } = opts;
    ctx.save();
    ctx.shadowColor = color; ctx.shadowBlur = 24;
    ctx.drawImage(img, cx - r, cy - r, r * 2, r * 2);
    ctx.shadowBlur = 0;
    ctx.lineWidth = 3; ctx.strokeStyle = ring;
    ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2); ctx.stroke();
    ctx.lineWidth = 1.5; ctx.strokeStyle = color;
    ctx.beginPath(); ctx.arc(cx, cy, r + 4, 0, Math.PI * 2); ctx.stroke();
    ctx.restore();
  }

  // Angle-cut corner frame: chamfers the top-left and bottom-right corners,
  // leaving the other two square — a restrained nod to angular HUD framing
  // without tipping into a fully-faceted, busy look.
  function cutCornerRect(x, y, w, h, cut) {
    ctx.beginPath();
    ctx.moveTo(x + cut, y);
    ctx.lineTo(x + w, y);
    ctx.lineTo(x + w, y + h - cut);
    ctx.lineTo(x + w - cut, y + h);
    ctx.lineTo(x, y + h);
    ctx.lineTo(x, y + cut);
    ctx.closePath();
  }

  // ── Pattern renderer ───────────────────────────────────────────────────────
  function drawPattern(type, x, y, w, h) {
    if (type === 'none') return;
    ctx.save();

    if (type === 'clouds') {
      let s = 42;
      const rnd = () => { s = Math.imul(s, 1664525) + 1013904223 | 0; return (s >>> 0) / 4294967295; };
      for (let i = 0; i < 22; i++) {
        const bx = x + (rnd() * 1.15 - 0.075) * w;
        const by = y + (rnd() * 1.15 - 0.075) * h;
        const r  = 50 + rnd() * 110;
        const a  = 0.09 + rnd() * 0.13;
        const g  = ctx.createRadialGradient(bx, by, 0, bx, by, r);
        g.addColorStop(0,   `rgba(255,255,255,${a.toFixed(3)})`);
        g.addColorStop(0.5, `rgba(255,255,255,${(a * 0.35).toFixed(3)})`);
        g.addColorStop(1,   'rgba(255,255,255,0)');
        ctx.fillStyle = g;
        ctx.fillRect(x, y, w, h);
      }

    } else if (type === 'polka') {
      const sp = 52, r = 10;
      for (let dy = sp * 0.5; dy <= h + sp; dy += sp) {
        const offset = (Math.floor(dy / sp) % 2) * (sp / 2);
        for (let dx = -sp + offset; dx <= w + sp; dx += sp) {
          const g = ctx.createRadialGradient(x+dx, y+dy, 0, x+dx, y+dy, r);
          g.addColorStop(0,   'rgba(255,255,255,0.28)');
          g.addColorStop(0.5, 'rgba(255,255,255,0.10)');
          g.addColorStop(1,   'rgba(255,255,255,0)');
          ctx.fillStyle = g;
          ctx.beginPath(); ctx.arc(x+dx, y+dy, r, 0, Math.PI*2); ctx.fill();
        }
      }

    } else if (type === 'hex') {
      ctx.strokeStyle = 'rgba(255,255,255,0.14)';
      ctx.lineWidth = 1;
      const size = 26, hexH = Math.sqrt(3) * size, colStep = size * 1.5;
      let colIdx = 0;
      for (let hx = x - size * 2; hx < x + w + size * 2; hx += colStep, colIdx++) {
        const rowOff = colIdx % 2 === 1 ? hexH / 2 : 0;
        for (let hy = y - hexH + rowOff; hy < y + h + hexH; hy += hexH) {
          ctx.beginPath();
          for (let i = 0; i < 6; i++) {
            const a = (Math.PI / 3) * i - Math.PI / 6;
            const px = hx + size * Math.cos(a), py = hy + size * Math.sin(a);
            i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
          }
          ctx.closePath(); ctx.stroke();
        }
      }

    } else if (type === 'stars') {
      let s = 77;
      const rnd = () => { s = Math.imul(s, 1664525) + 1013904223 | 0; return (s >>> 0) / 4294967295; };
      // Small dense field
      for (let i = 0; i < 90; i++) {
        const sx = x + rnd() * w, sy = y + rnd() * h;
        const sr = 0.7 + rnd() * 1.8;
        const sa = 0.18 + rnd() * 0.50;
        const g = ctx.createRadialGradient(sx, sy, 0, sx, sy, sr * 3.5);
        g.addColorStop(0,   `rgba(255,255,255,${sa.toFixed(2)})`);
        g.addColorStop(0.25,`rgba(255,255,255,${(sa * 0.5).toFixed(2)})`);
        g.addColorStop(1,   'rgba(255,255,255,0)');
        ctx.fillStyle = g;
        ctx.fillRect(sx - sr*3.5, sy - sr*3.5, sr*7, sr*7);
      }
      // A few larger sparkle highlights
      for (let i = 0; i < 8; i++) {
        const sx = x + rnd() * w, sy = y + rnd() * h;
        const sr = 3 + rnd() * 5;
        const sa = 0.30 + rnd() * 0.30;
        const g = ctx.createRadialGradient(sx, sy, 0, sx, sy, sr * 4);
        g.addColorStop(0,   `rgba(255,255,255,${sa.toFixed(2)})`);
        g.addColorStop(0.15,`rgba(255,255,255,${(sa * 0.6).toFixed(2)})`);
        g.addColorStop(1,   'rgba(255,255,255,0)');
        ctx.fillStyle = g;
        ctx.fillRect(sx - sr*4, sy - sr*4, sr*8, sr*8);
        // Cross flare
        ctx.strokeStyle = `rgba(255,255,255,${(sa * 0.4).toFixed(2)})`;
        ctx.lineWidth = 0.7;
        ctx.beginPath(); ctx.moveTo(sx - sr*5, sy); ctx.lineTo(sx + sr*5, sy); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(sx, sy - sr*5); ctx.lineTo(sx, sy + sr*5); ctx.stroke();
      }
    }

    ctx.restore();
  }

  // ── Main draw ──────────────────────────────────────────────────────────────
  // Three selectable layouts (state.layout) share the same building blocks
  // (art panel, name plate, attack panel, footer) but arrange them differently:
  //   half    — framed illustration on the top half, all info stacked below
  //   quarter — small framed illustration top-right, info column on the left
  //   full    — illustration fills the card, info overlays it on scrims
  async function drawCard() {
    const W = CARD_W, H = CARD_H;
    const pal = getPalette();
    const elemImg  = await loadElemImg(state.element);
    const portalBg = state.background === 'element' ? await loadPortalBg(state.element) : null;
    const bgBase   = arcBgImg || portalBg;
    const srcImg   = arcArtImg || charImg;
    const nameText = () => state.customName.trim() || state.characterName || '???';

    ctx.clearRect(0, 0, W, H);
    ctx.save();
    roundedRect(0, 0, W, H, CORNER_R);
    ctx.clip();

    // ── Building block: illustration panel (portal/archive bg + character art) ─
    function drawArtPanel(x, y, w, h, { framed = false, cornerStyle = 'round' } = {}) {
      lastArtPanelRect = { x, y, w, h };
      ctx.save();
      if (framed) {
        if (cornerStyle === 'cut') cutCornerRect(x, y, w, h, Math.min(w, h) * 0.07);
        else roundedRect(x, y, w, h, 24);
        ctx.clip();
      }

      const bgTransparent = state.background === 'transparent';

      if (!bgTransparent) {
        // Opaque backing fill first — the portal/archive background art has soft,
        // semi-transparent edges (it's painted with alpha vignettes), so without
        // a solid base beneath it those soft regions let the canvas's real
        // transparency show through as visible "holes" in the card.
        ctx.fillStyle = pal.dark;
        ctx.fillRect(x, y, w, h);

        if (bgBase) {
          const iw = bgBase.naturalWidth, ih = bgBase.naturalHeight;
          const scale = Math.max(w / iw, h / ih);
          const dw = iw * scale, dh = ih * scale;
          ctx.drawImage(bgBase, x + (w - dw) / 2, y + (h - dh) / 2, dw, dh);
        }

        const artGrad = ctx.createLinearGradient(x, y, x + w * 0.9, y + h);
        artGrad.addColorStop(0,   pal.mid);
        artGrad.addColorStop(0.3, pal.mid2);
        artGrad.addColorStop(0.6, pal.accent + 'cc');
        artGrad.addColorStop(0.85,pal.mid2);
        artGrad.addColorStop(1,   pal.mid);
        ctx.globalAlpha = bgBase ? state.bgColorOpacity : 1;
        ctx.fillStyle = artGrad;
        ctx.fillRect(x, y, w, h);
        ctx.globalAlpha = 1;

        const gcx = x + w / 2, gcy = y + h * 0.48;
        const glow = ctx.createRadialGradient(gcx, gcy, 0, gcx, gcy, Math.max(w, h) * 0.62);
        glow.addColorStop(0,   pal.accent + '38');
        glow.addColorStop(0.4, pal.accent + '14');
        glow.addColorStop(1,   'transparent');
        ctx.fillStyle = glow;
        ctx.fillRect(x, y, w, h);

        if (elemImg && state.showElement) {
          const wmS = Math.min(h, w) * 0.72;
          ctx.save();
          ctx.globalAlpha = 0.09;
          ctx.drawImage(elemImg, x + (w - wmS) / 2, y + (h - wmS) / 2, wmS, wmS);
          ctx.restore();
        }

        const vig = ctx.createRadialGradient(x+w/2, y+h/2, Math.min(w,h)*0.28, x+w/2, y+h/2, Math.max(w,h)*0.78);
        vig.addColorStop(0, 'transparent');
        vig.addColorStop(1, 'rgba(0,0,0,0.18)');
        ctx.fillStyle = vig;
        ctx.fillRect(x, y, w, h);

        drawPattern(state.pattern, x, y, w, h);

        if (arcDetailImg) {
          const iw = arcDetailImg.naturalWidth, ih = arcDetailImg.naturalHeight;
          const scale = Math.min(w / iw, h / ih);
          const dw = iw * scale, dh = ih * scale;
          ctx.drawImage(arcDetailImg, x + (w - dw) / 2, y + h - dh, dw, dh);
        }
      }

      // Painted illustrations (hi-res character art, chosen archive art, custom
      // uploads) are full rectangles, not transparent in-game cutouts — fill the
      // frame edge-to-edge instead of floating them with the cutout glow, which
      // just smears their soft painted edges into the panel's gradient.
      const srcIsArt = srcImg && (srcImg === arcArtImg || (srcImg === charImg && charImgIsArt));

      if (srcIsArt) {
        const iw = srcImg.naturalWidth || w, ih = srcImg.naturalHeight || h;
        const sc = Math.max(w / iw, h / ih) * state.artZoom;
        const dw = iw * sc, dh = ih * sc;
        ctx.drawImage(srcImg, x + (w - dw) / 2 + state.artOffsetX, y + (h - dh) / 2 + state.artOffsetY, dw, dh);
      } else if (srcImg) {
        const pad = Math.min(w, h) * 0.05;
        let iw = srcImg.naturalWidth || 400, ih = srcImg.naturalHeight || 400;
        const sc = Math.min((w-pad*2)/iw, (h-pad*2)/ih) * state.artZoom;
        iw *= sc; ih *= sc;
        const ix = x + (w-iw)/2 + state.artOffsetX, iy = y + (h-ih)/2 + state.artOffsetY;
        ctx.save(); ctx.shadowColor = pal.accent; ctx.shadowBlur = 70; ctx.globalAlpha = 0.5; ctx.drawImage(srcImg,ix,iy,iw,ih); ctx.restore();
        ctx.drawImage(srcImg, ix, iy, iw, ih);
      } else {
        const fs1 = Math.max(15, Math.min(w, h) * 0.072);
        ctx.fillStyle = 'rgba(255,255,255,0.22)'; ctx.font = `bold ${fs1}px Arial`; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillText('Select a character', x + w/2, y + h/2 - fs1*0.7);
        if (w > 280) {
          ctx.font = `${fs1*0.65}px Arial`; ctx.fillStyle = 'rgba(255,255,255,0.1)';
          ctx.fillText('← Choose from the left panel', x + w/2, y + h/2 + fs1*0.85);
        }
        ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic';
      }

      ctx.restore();

      const BP = Math.min(w,h) * 0.022, BL = Math.min(w,h) * 0.075;
      ctx.save(); ctx.shadowColor = pal.accent; ctx.shadowBlur = 14;
      cornerBrackets(x+BP, y+BP, w-BP*2, h-BP*2, BL, 6, pal.accent); ctx.restore();
      cornerBrackets(x+BP, y+BP, w-BP*2, h-BP*2, BL, 2, pal.highlight || '#fff');
    }

    // ── Building block: name + element ribbon (used by half/quarter layouts) ──
    function drawNamePlate(x, y, w, h, opts = {}) {
      const { badgeGutter = 0 } = opts;
      const grad = ctx.createLinearGradient(x, y, x + w * 1.1, y + h);
      grad.addColorStop(0,    pal.dark);
      grad.addColorStop(0.25, pal.mid);
      grad.addColorStop(0.6,  pal.accent);
      grad.addColorStop(1,    pal.mid2);
      ctx.fillStyle = grad; ctx.fillRect(x, y, w, h);
      diagonalStripes(x, y, w, h, 28, 10, '#000', 0.07);
      const sheen = ctx.createLinearGradient(x, y, x, y + h * 0.55);
      sheen.addColorStop(0, 'rgba(255,255,255,0.20)'); sheen.addColorStop(1, 'rgba(255,255,255,0)');
      ctx.fillStyle = sheen; ctx.fillRect(x, y, w, h * 0.55);

      // When a seam badge straddles the divider above this plate, it already
      // carries the element mark — skip the in-plate icon and start the name
      // clear of the badge's footprint instead of layering a second one.
      let nameX = x + 18;
      if (badgeGutter > 0) {
        nameX = x + badgeGutter;
      } else if (elemImg && state.showElement) {
        const ESZ = Math.min(h * 0.62, 72), EX = x + 14, EY = y + (h - ESZ) / 2;
        ctx.save();
        const ig = ctx.createRadialGradient(EX+ESZ/2, EY+ESZ/2, 0, EX+ESZ/2, EY+ESZ/2, ESZ*0.8);
        ig.addColorStop(0, 'rgba(255,255,255,0.30)'); ig.addColorStop(1, 'rgba(255,255,255,0)');
        ctx.fillStyle = ig; ctx.beginPath(); ctx.arc(EX+ESZ/2, EY+ESZ/2, ESZ*0.8, 0, Math.PI*2); ctx.fill();
        ctx.shadowColor = 'rgba(255,255,255,0.4)'; ctx.shadowBlur = 12;
        ctx.drawImage(elemImg, EX, EY, ESZ, ESZ);
        ctx.restore();
        nameX = EX + ESZ + 14;
      }

      if (state.showName) {
        const txt = nameText();
        const maxW = x + w - nameX - 14;
        let fs = Math.min(64, h * 0.5);
        const fontFn = FONT_DEFS[state.nameFont] || FONT_DEFS.bebas;
        ctx.font = fontFn(fs);
        while (ctx.measureText(txt).width > maxW && fs > 22) { fs -= 2; ctx.font = fontFn(fs); }
        ctx.save();
        ctx.shadowColor = pal.accent; ctx.shadowBlur = 18;
        ctx.fillStyle = '#fff'; ctx.textBaseline = 'alphabetic'; ctx.textAlign = 'left';
        ctx.fillText(txt, nameX, y + h * 0.6);
        ctx.restore();

        if (state.element) {
          ctx.font = `600 ${Math.max(16, h * 0.165)}px 'Rajdhani', Arial, sans-serif`;
          ctx.fillStyle = pal.highlight || 'rgba(255,255,255,0.65)';
          ctx.fillText(state.element.toUpperCase(), nameX, y + h * 0.86);
        }
        const metaLine = [state.species, state.gender, state.role].filter(Boolean).join('  ·  ');
        if (metaLine) {
          ctx.save();
          ctx.font = `600 ${Math.max(13, h * 0.13)}px 'Rajdhani', Arial, sans-serif`;
          ctx.shadowColor = 'rgba(0,0,0,0.75)'; ctx.shadowBlur = 7; ctx.shadowOffsetY = 1;
          ctx.fillStyle = 'rgba(255,255,255,0.88)';
          ctx.textAlign = 'right';
          ctx.fillText(metaLine, x + w - 16, y + h * 0.86);
          ctx.restore();
          ctx.textAlign = 'left';
        }
      }
    }

    // ── Building block: opaque attack info panel (half/quarter layouts) ───────
    function drawAttackPanel(x, y, w, h) {
      ctx.fillStyle = '#0a0a0a'; ctx.fillRect(x, y, w, h);
      const sg = ctx.createLinearGradient(0, y, 0, y + h);
      sg.addColorStop(0, pal.accent); sg.addColorStop(0.5, pal.highlight || pal.accent); sg.addColorStop(1, pal.accent);
      ctx.fillStyle = sg; ctx.globalAlpha = 0.8; ctx.fillRect(x, y, 5, h); ctx.globalAlpha = 1;

      const PAD = 20;
      let ay = y + PAD;
      const an = state.attackName.trim(), ad = state.attackDesc.trim(), adm = state.attackDamage.trim();

      if (an || ad) {
        const ICON = 52, banH = ICON + 16;
        const bg2 = ctx.createLinearGradient(x, ay, x + w, ay);
        bg2.addColorStop(0, pal.accent + '2E'); bg2.addColorStop(0.6, pal.accent + '16'); bg2.addColorStop(1, 'transparent');
        ctx.fillStyle = bg2; ctx.fillRect(x, ay - 6, w, banH);

        // A chosen archive attack icon (the Skylander's own ability artwork)
        // takes precedence as the flavour icon; otherwise fall back to the
        // generic element badge, as before.
        const attackIcon = arcAttackIconImg || (state.showElement ? elemImg : null);
        if (attackIcon) ctx.drawImage(attackIcon, x + PAD + 4, ay, ICON, ICON);
        const anx = attackIcon ? x + PAD + ICON + 16 : x + PAD + 4;

        ctx.font = `40px 'Bebas Neue', Impact, sans-serif`; ctx.fillStyle = pal.accent; ctx.textBaseline = 'middle'; ctx.textAlign = 'left';
        ctx.fillText((an || 'ATTACK').toUpperCase(), anx, ay + ICON / 2);

        if (adm) {
          ctx.font = `700 60px 'Rajdhani', Arial, sans-serif`; ctx.fillStyle = '#fff'; ctx.textAlign = 'right';
          ctx.fillText(adm, x + w - PAD, ay + ICON / 2 + 13); ctx.textAlign = 'left';
        }
        ay += banH + 2;

        const sep = ctx.createLinearGradient(x + PAD, 0, x + w - PAD, 0);
        sep.addColorStop(0, 'transparent'); sep.addColorStop(0.12, pal.accent); sep.addColorStop(0.88, pal.accent); sep.addColorStop(1, 'transparent');
        ctx.fillStyle = sep; ctx.globalAlpha = 0.40; ctx.fillRect(x + PAD, ay, w - PAD * 2, 2); ctx.globalAlpha = 1;
        ay += 14;

        if (ad) {
          ctx.font = `21px 'Atkinson Hyperlegible', Arial, sans-serif`; ctx.fillStyle = 'rgba(255,255,255,0.82)';
          ctx.textBaseline = 'top'; ctx.textAlign = 'left';
          wrapText(ad, x + PAD + 8, ay, w - PAD * 2 - 8, 30, Math.floor((y + h - 20 - ay) / 30));
        }
      } else {
        ctx.font = `19px 'Atkinson Hyperlegible', Arial, sans-serif`; ctx.fillStyle = 'rgba(255,255,255,0.16)';
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillText('Fill in the Attack fields above →', x + w / 2, y + h / 2);
      }
      ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic';
    }

    // ── Building block: footer band with logo + flanking element icons ────────
    function drawFooterBand(y, h) {
      const fg = ctx.createLinearGradient(0, y, 0, y + h);
      fg.addColorStop(0, pal.mid); fg.addColorStop(1, pal.dark);
      ctx.fillStyle = fg; ctx.fillRect(0, y, W, h);

      const dl = ctx.createLinearGradient(0, y, W, y);
      dl.addColorStop(0,    'transparent');
      dl.addColorStop(0.12, pal.accent);
      dl.addColorStop(0.88, pal.accent);
      dl.addColorStop(1,    'transparent');
      ctx.fillStyle = dl; ctx.fillRect(0, y, W, 3);

      const fcy = y + h / 2;
      if (state.showLogo && logoImg) {
        const lh = 76, lw = lh * (logoImg.naturalWidth / (logoImg.naturalHeight || 1));
        ctx.save(); ctx.globalAlpha = 0.82; ctx.drawImage(logoImg, (W - lw) / 2, fcy - lh / 2, lw, lh); ctx.restore();
      } else {
        ctx.font = `bold 17px 'Atkinson Hyperlegible', Arial, sans-serif`; ctx.fillStyle = 'rgba(255,255,255,0.25)';
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText('SKYLANDERS', W / 2, fcy);
      }
      if (elemImg && state.showElement) {
        const FI = 52;
        ctx.save(); ctx.globalAlpha = 0.62;
        ctx.drawImage(elemImg, 18, fcy - FI / 2, FI, FI);
        ctx.drawImage(elemImg, W - FI - 18, fcy - FI / 2, FI, FI);
        ctx.restore();
      }
    }

    // ── Building block: vertically-centred name/element column (quarter layout)
    function drawInfoColumn(x, y, w, h) {
      const hasIcon = !!(elemImg && state.showElement);
      const ESZ = Math.min(w * 0.4, 88);
      const fontFn = FONT_DEFS[state.nameFont] || FONT_DEFS.bebas;
      const txt = nameText();
      let fs = 56;
      ctx.font = fontFn(fs);
      while (ctx.measureText(txt).width > w && fs > 24) { fs -= 2; ctx.font = fontFn(fs); }
      const efs = 21, GAP = 20;
      const ruleW = Math.min(w * 0.55, 120);

      let contentH = 4;
      if (hasIcon) contentH += ESZ + GAP;
      if (state.showName) {
        contentH += fs + GAP;
        if (state.element) contentH += efs + GAP;
      }

      let cy = y + Math.max(22, (h - contentH) / 2);

      if (hasIcon) {
        ctx.save();
        const ig = ctx.createRadialGradient(x+ESZ/2, cy+ESZ/2, 0, x+ESZ/2, cy+ESZ/2, ESZ*0.8);
        ig.addColorStop(0, 'rgba(255,255,255,0.30)'); ig.addColorStop(1, 'rgba(255,255,255,0)');
        ctx.fillStyle = ig; ctx.beginPath(); ctx.arc(x+ESZ/2, cy+ESZ/2, ESZ*0.8, 0, Math.PI*2); ctx.fill();
        ctx.shadowColor = 'rgba(255,255,255,0.4)'; ctx.shadowBlur = 12;
        ctx.drawImage(elemImg, x, cy, ESZ, ESZ);
        ctx.restore();
        cy += ESZ + GAP;
      }

      if (state.showName) {
        ctx.save();
        ctx.shadowColor = pal.accent; ctx.shadowBlur = 18;
        ctx.fillStyle = '#fff'; ctx.font = fontFn(fs); ctx.textBaseline = 'alphabetic'; ctx.textAlign = 'left';
        ctx.fillText(txt, x, cy + fs * 0.78);
        ctx.restore();
        cy += fs + GAP;

        if (state.element) {
          ctx.font = `600 ${efs}px 'Rajdhani', Arial, sans-serif`;
          ctx.fillStyle = pal.highlight || 'rgba(255,255,255,0.65)';
          ctx.fillText(state.element.toUpperCase(), x, cy + efs * 0.8);
          cy += efs + GAP;
        }
        const metaLine = [state.species, state.gender, state.role].filter(Boolean).join('  ·  ');
        if (metaLine) {
          const mfs = 14;
          ctx.save();
          ctx.font = `600 ${mfs}px 'Rajdhani', Arial, sans-serif`;
          ctx.shadowColor = 'rgba(0,0,0,0.75)'; ctx.shadowBlur = 6; ctx.shadowOffsetY = 1;
          ctx.fillStyle = 'rgba(255,255,255,0.88)';
          ctx.fillText(metaLine, x, cy + mfs * 0.8);
          ctx.restore();
          cy += mfs + GAP;
        }
      }

      const rg = ctx.createLinearGradient(x, 0, x + ruleW, 0);
      rg.addColorStop(0, pal.highlight || pal.accent); rg.addColorStop(1, 'transparent');
      ctx.fillStyle = rg; ctx.globalAlpha = 0.7; ctx.fillRect(x, cy, ruleW, 3); ctx.globalAlpha = 1;
    }

    // ── Building blocks: name + attack overlays drawn directly on art (full) ──
    function drawNameOverlay(x, y, w) {
      if (!state.showName && !(elemImg && state.showElement)) return;
      const ESZ = 64;
      let nameX = x;
      if (elemImg && state.showElement) {
        ctx.save();
        ctx.shadowColor = 'rgba(0,0,0,0.55)'; ctx.shadowBlur = 14;
        ctx.drawImage(elemImg, x, y, ESZ, ESZ);
        ctx.restore();
        nameX = x + ESZ + 16;
      }
      if (state.showName) {
        const txt = nameText();
        const fontFn = FONT_DEFS[state.nameFont] || FONT_DEFS.bebas;
        let fs = 60;
        const maxW = x + w - nameX;
        ctx.font = fontFn(fs);
        while (ctx.measureText(txt).width > maxW && fs > 26) { fs -= 2; ctx.font = fontFn(fs); }
        ctx.save();
        ctx.shadowColor = 'rgba(0,0,0,0.7)'; ctx.shadowBlur = 16; ctx.shadowOffsetY = 2;
        ctx.fillStyle = '#fff'; ctx.textBaseline = 'alphabetic'; ctx.textAlign = 'left';
        ctx.fillText(txt, nameX, y + ESZ * 0.62);
        ctx.restore();

        if (state.element) {
          ctx.save();
          ctx.shadowColor = 'rgba(0,0,0,0.6)'; ctx.shadowBlur = 8;
          ctx.font = `600 21px 'Rajdhani', Arial, sans-serif`;
          ctx.fillStyle = pal.highlight || 'rgba(255,255,255,0.8)';
          ctx.fillText(state.element.toUpperCase(), nameX, y + ESZ * 0.62 + 26);
          ctx.restore();
        }
        const metaLine = [state.species, state.gender, state.role].filter(Boolean).join('  ·  ');
        if (metaLine) {
          ctx.save();
          ctx.shadowColor = 'rgba(0,0,0,0.85)'; ctx.shadowBlur = 8; ctx.shadowOffsetY = 1;
          ctx.font = `600 14px 'Rajdhani', Arial, sans-serif`;
          ctx.fillStyle = 'rgba(255,255,255,0.90)';
          ctx.fillText(metaLine, nameX, y + ESZ * 0.62 + 46);
          ctx.restore();
        }
      }
    }

    function drawAttackOverlay(x, y, w, h) {
      const PAD = 28;
      let ay = y + PAD;
      const an = state.attackName.trim(), ad = state.attackDesc.trim(), adm = state.attackDamage.trim();
      if (an || ad) {
        const ICON = 50;
        const attackIcon = arcAttackIconImg || (state.showElement ? elemImg : null);
        if (attackIcon) {
          ctx.save(); ctx.shadowColor = 'rgba(0,0,0,0.5)'; ctx.shadowBlur = 8;
          ctx.drawImage(attackIcon, x + PAD, ay, ICON, ICON);
          ctx.restore();
        }
        const anx = attackIcon ? x + PAD + ICON + 14 : x + PAD;
        ctx.save(); ctx.shadowColor = 'rgba(0,0,0,0.65)'; ctx.shadowBlur = 10;
        ctx.font = `40px 'Bebas Neue', Impact, sans-serif`; ctx.fillStyle = pal.highlight || '#fff';
        ctx.textBaseline = 'middle'; ctx.textAlign = 'left';
        ctx.fillText((an || 'ATTACK').toUpperCase(), anx, ay + ICON / 2);
        if (adm) {
          ctx.font = `700 56px 'Rajdhani', Arial, sans-serif`; ctx.fillStyle = '#fff'; ctx.textAlign = 'right';
          ctx.fillText(adm, x + w - PAD, ay + ICON / 2 + 12); ctx.textAlign = 'left';
        }
        ctx.restore();
        ay += ICON + 24;

        if (ad) {
          ctx.save();
          ctx.shadowColor = 'rgba(0,0,0,0.65)'; ctx.shadowBlur = 8;
          ctx.font = `21px 'Atkinson Hyperlegible', Arial, sans-serif`; ctx.fillStyle = 'rgba(255,255,255,0.92)';
          ctx.textBaseline = 'top'; ctx.textAlign = 'left';
          wrapText(ad, x + PAD, ay, w - PAD * 2, 30, Math.floor((y + h - 20 - ay) / 30));
          ctx.restore();
        }
      }
      ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic';
    }

    // ════ LAYOUT 1: Half Image — framed illustration on top, info stacked below
    function layoutHalf() {
      const PAD = 24, GAP = 6;
      const nameRowH = 100, attackH = 246;
      const frameX = PAD, frameY = PAD, frameW = W - PAD * 2;
      const frameH = FTR_Y - frameY - GAP - nameRowH - (state.showAttack ? attackH + DIV3_H : 0);

      drawArtPanel(frameX, frameY, frameW, frameH, { framed: true, cornerStyle: 'cut' });

      const nameY = frameY + frameH + GAP;

      // Seam badge: the element icon, re-cast as a tinted emblem that punches
      // through a single glowing rule along the illustration→plate divider —
      // the card's focal accent, in place of the old diagonal energy-cut.
      const showBadge = !!(elemImg && state.showElement);
      const badgeR = Math.min(nameRowH * 0.62, 58);
      const badgeCx = frameX + badgeR + 24;
      const badgeGutter = showBadge ? (badgeCx + badgeR + 18) : 0;

      drawNamePlate(0, nameY, W, nameRowH, { badgeGutter });
      drawAccentRule(nameY, W, pal.accent, { from: 0.05, to: 0.96, thick: 3 });
      if (showBadge) {
        drawSeamBadge(badgeCx, nameY, badgeR, elemImg, pal.accent, { ring: pal.highlight || '#ffffff' });
      }

      if (state.showAttack) {
        const atkY = nameY + nameRowH;
        drawAttackPanel(0, atkY, W, attackH);
        drawAccentRule(atkY, W, pal.highlight || pal.accent, { from: 0.4, to: 0.97, thick: 2.5, glow: 12 });
        ctx.fillStyle = '#1a1a1a'; ctx.fillRect(0, atkY + attackH, W, DIV3_H);
      }

      drawFooterBand(FTR_Y, FTR_H);
    }

    // ════ LAYOUT 2: Quarter Image — small framed art top-right, info column left
    function layoutQuarter() {
      const PAD = 24, GAP = 20;
      const artW = 272, artH2 = Math.round(artW * 1.35);
      const topH = state.showAttack ? Math.max(artH2 + PAD * 2, 440) : (FTR_Y - PAD);

      const bgGrad = ctx.createLinearGradient(0, 0, W * 1.05, topH);
      bgGrad.addColorStop(0,    pal.dark);
      bgGrad.addColorStop(0.35, pal.mid);
      bgGrad.addColorStop(0.7,  pal.accent);
      bgGrad.addColorStop(1,    pal.mid2);
      ctx.fillStyle = bgGrad; ctx.fillRect(0, 0, W, topH);
      diagonalStripes(0, 0, W, topH, 28, 10, '#000', 0.06);
      const sheen = ctx.createLinearGradient(0, 0, 0, topH * 0.42);
      sheen.addColorStop(0, 'rgba(255,255,255,0.16)'); sheen.addColorStop(1, 'rgba(255,255,255,0)');
      ctx.fillStyle = sheen; ctx.fillRect(0, 0, W, topH * 0.42);

      const artX = W - PAD - artW, artY = (topH - artH2) / 2;
      const infoX = PAD, infoW = artX - GAP - infoX;

      drawInfoColumn(infoX, 0, infoW, topH);
      drawArtPanel(artX, artY, artW, artH2, { framed: true });

      ctx.fillStyle = '#000'; ctx.fillRect(0, topH, W, DIV1_H);

      if (state.showAttack) {
        const atkY = topH + DIV1_H;
        const attackH = FTR_Y - atkY - DIV3_H;
        drawAttackPanel(0, atkY, W, attackH);
        drawSeamCut(topH + DIV1_H / 2, W, pal.accent, { from: 0.06, to: 0.6, thick: 13, rise: 42 });
        ctx.fillStyle = '#1a1a1a'; ctx.fillRect(0, atkY + attackH, W, DIV3_H);
      }

      drawFooterBand(FTR_Y, FTR_H);
    }

    // ════ LAYOUT 3: Full Image — illustration fills the card, info overlays it
    function layoutFull() {
      drawArtPanel(0, 0, W, H);

      const topScrimH = 196;
      const topScrim = ctx.createLinearGradient(0, 0, 0, topScrimH);
      topScrim.addColorStop(0, 'rgba(0,0,0,0.6)');
      topScrim.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = topScrim; ctx.fillRect(0, 0, W, topScrimH);
      drawNameOverlay(30, 28, W - 60);

      if (state.showAttack) {
        const atkH = 320, atkY = H - atkH;
        const botScrim = ctx.createLinearGradient(0, atkY - 70, 0, H);
        botScrim.addColorStop(0,    'rgba(0,0,0,0)');
        botScrim.addColorStop(0.32, 'rgba(0,0,0,0.58)');
        botScrim.addColorStop(1,    'rgba(0,0,0,0.86)');
        ctx.fillStyle = botScrim; ctx.fillRect(0, atkY - 70, W, atkH + 70);
        drawAttackOverlay(0, atkY, W, atkH);
      }

      if (state.showLogo && logoImg) {
        const lh = 50, lw = lh * (logoImg.naturalWidth / (logoImg.naturalHeight || 1));
        ctx.save();
        ctx.globalAlpha = 0.8; ctx.shadowColor = 'rgba(0,0,0,0.65)'; ctx.shadowBlur = 12;
        ctx.drawImage(logoImg, (W - lw) / 2, H - lh - 24, lw, lh);
        ctx.restore();
      }
    }

    if (state.layout === 'quarter')      layoutQuarter();
    else if (state.layout === 'full')    layoutFull();
    else                                 layoutHalf();

    // ════ TRIPLE-LAYER BORDER ════════════════════════════════════════════
    ctx.save();
    roundedRect(2, 2, W-4, H-4, CORNER_R-2); ctx.strokeStyle = '#000'; ctx.lineWidth = 7; ctx.stroke();
    roundedRect(7, 7, W-14, H-14, CORNER_R-7); ctx.strokeStyle = pal.accent; ctx.lineWidth = 2.5; ctx.globalAlpha = 0.65; ctx.stroke();
    roundedRect(11, 11, W-22, H-22, CORNER_R-11); ctx.strokeStyle = pal.highlight||'rgba(255,255,255,0.5)'; ctx.lineWidth = 1; ctx.globalAlpha = 0.22; ctx.stroke();
    ctx.restore();

    ctx.restore(); // card clip
  }

  // ── Character selection ────────────────────────────────────────────────────
  async function selectCharacter(char) {
    state.characterName = char.name;
    state.element  = char.element  || null;
    state.species  = char.species  || null;
    state.gender   = char.gender   || null;
    state.role     = char.role     || null;
    if (!state.customName) document.getElementById('name-input').placeholder = char.name;
    usingCustomImg = false;
    document.getElementById('custom-indicator').style.display = 'none';
    document.getElementById('custom-img').value = '';
    // Reset archive selections on new character
    arcBgImg = null; arcDetailImg = null; arcArtImg = null; arcAttackIconImg = null;
    arcBgUrl = null; arcDetailUrl = null; arcArtUrl = null; arcAttackIconUrl = null;
    resetArtTransform();
    updateBgOpacityRow();
    document.querySelectorAll('.char-thumb').forEach(el => el.classList.toggle('selected', el.dataset.name === char.name));
    document.getElementById('export-btn').disabled = false;
    charImg = await loadCharImg(char.name);
    drawCard();
    loadArchivePickers(char.name);
  }

  // ── Archive image picker ───────────────────────────────────────────────────
  function buildArcGallery(galleryEl, statusEl, images, activeUrl, onSelect) {
    galleryEl.innerHTML = '';
    if (!images.length) {
      galleryEl.style.display = 'none';
      if (statusEl) statusEl.textContent = '';
      return;
    }
    galleryEl.style.display = '';
    if (statusEl) statusEl.textContent = '';
    images.forEach(imgData => {
      const thumb = document.createElement('button');
      thumb.className = 'arc-thumb' + (imgData.url === activeUrl ? ' selected' : '');
      thumb.title = imgData.game;
      const img = document.createElement('img');
      img.src = imgData.url; img.alt = ''; img.loading = 'lazy'; img.crossOrigin = 'anonymous';
      thumb.appendChild(img);
      thumb.addEventListener('click', async () => {
        galleryEl.querySelectorAll('.arc-thumb').forEach(t => t.classList.remove('selected'));
        thumb.classList.add('selected');
        onSelect(imgData.url, await loadArcImg(imgData.url));
        drawCard();
      });
      galleryEl.appendChild(thumb);
    });
  }

  async function loadArchivePickers(charName) {
    const index = await fetchArchiveIndex();

    const bgGallery     = document.getElementById('arc-bg-gallery');
    const bgStatus      = document.getElementById('arc-bg-status');
    const detailGallery = document.getElementById('arc-detail-gallery');
    const detailStatus  = document.getElementById('arc-detail-status');
    const artSection    = document.getElementById('arc-art-section');
    const artGallery    = document.getElementById('arc-art-gallery');
    const artStatus     = document.getElementById('arc-art-status');
    const attackSection = document.getElementById('arc-attack-section');
    const attackGallery = document.getElementById('arc-attack-gallery');
    const attackStatus  = document.getElementById('arc-attack-status');

    if (!index) {
      bgStatus.textContent = detailStatus.textContent = 'Archive index not found — run `npm run publish-archive`';
      bgGallery.style.display = detailGallery.style.display = 'none';
      artSection.style.display = attackSection.style.display = 'none';
      return;
    }

    // Background picker — all background-annotated images globally
    buildArcGallery(bgGallery, bgStatus, index.backgrounds || [], arcBgUrl,
      (url, img) => { arcBgUrl = url; arcBgImg = img; updateBgOpacityRow(); });

    // Detail picker — all detail-annotated images globally
    buildArcGallery(detailGallery, detailStatus, index.details || [], arcDetailUrl,
      (url, img) => { arcDetailUrl = url; arcDetailImg = img; });

    // Character-specific tagged images, split into portrait art (selectable as
    // the card's character image) and ability/attack icons (selectable only as
    // a small flavour icon on the attack panel — never as the character image).
    const charImages   = (index.byCharacter || {})[charName.toLowerCase()] || [];
    const isAttackIcon = im => (im.anns || []).includes('attack');
    const allArtImages  = charImages.filter(im => !isAttackIcon(im));
    const attackImages  = charImages.filter(isAttackIcon);

    const showAllEl = document.getElementById('arc-show-all');
    const showAll   = showAllEl?.checked ?? false;
    const artImages = showAll
      ? allArtImages
      : allArtImages.filter(im => im.featured !== false);

    // Re-bind toggle so switching "show all" refreshes gallery for current char
    if (showAllEl) {
      showAllEl.onchange = () => loadArchivePickers(charName);
    }

    // Show the section if there are any art images at all (even unfeatured)
    artSection.style.display = allArtImages.length ? '' : 'none';
    buildArcGallery(artGallery, artStatus, artImages, arcArtUrl,
      (url, img) => { arcArtUrl = url; arcArtImg = img; resetArtTransform(); });

    attackSection.style.display = attackImages.length ? '' : 'none';
    buildArcGallery(attackGallery, attackStatus, attackImages, arcAttackIconUrl,
      (url, img) => { arcAttackIconUrl = url; arcAttackIconImg = img; });

    // Preload every tagged image up front — same eager-load approach as the
    // base charImg on selection — so the prev/next arrows (and attack-icon
    // picks) page instantly from arcImgCache instead of showing a load flicker.
    browseArrowsEl.classList.toggle('show', artImages.length > 1);
    if (artImages.length > 1) Promise.all(artImages.map(img => loadArcImg(img.url)));
    if (attackImages.length) Promise.all(attackImages.map(img => loadArcImg(img.url)));
  }

  // ── Build character grid ───────────────────────────────────────────────────
  function buildGrid(filter = '', elemFilter = null) {
    const grid = document.getElementById('char-grid');
    grid.innerHTML = '';
    const q = filter.toLowerCase();
    const list = CHARS.filter(c => (!q || c.name.toLowerCase().includes(q)) && (!elemFilter || c.element === elemFilter));
    if (!list.length) {
      const m = document.createElement('div'); m.className = 'char-no-results'; m.textContent = 'No characters found'; grid.appendChild(m); return;
    }
    list.forEach(char => {
      const btn = document.createElement('button');
      btn.className = 'char-thumb'; btn.dataset.name = char.name; btn.title = char.name;
      if (char.name === state.characterName) btn.classList.add('selected');
      // char.image points at the wiki's CDN, which now blocks hotlinking
      // (HTTP 401) — use the small local cutouts synced for exactly this
      // purpose instead. Try .png first, fall back to .jpg once on error.
      const img = document.createElement('img');
      const slug = char.name.toLowerCase().replace(/[^a-z0-9]/g, '-');
      img.src = `/images/server/characters/${slug}.png`;
      img.onerror = () => { img.onerror = null; img.src = `/images/server/characters/${slug}.jpg`; };
      img.alt = char.name; img.loading = 'lazy';
      btn.appendChild(img); btn.addEventListener('click', () => selectCharacter(char)); grid.appendChild(btn);
    });
  }

  // ── Controls ───────────────────────────────────────────────────────────────
  let elemFilter = null;

  document.getElementById('char-search').addEventListener('input', e => buildGrid(e.target.value, elemFilter));

  document.querySelectorAll('.elem-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      if (elemFilter === btn.dataset.element) { elemFilter = null; btn.classList.remove('active'); }
      else { elemFilter = btn.dataset.element; document.querySelectorAll('.elem-btn').forEach(b => b.classList.remove('active')); btn.classList.add('active'); }
      buildGrid(document.getElementById('char-search').value, elemFilter);
    });
  });
  document.getElementById('elem-clear').addEventListener('click', () => {
    elemFilter = null; document.querySelectorAll('.elem-btn').forEach(b => b.classList.remove('active'));
    buildGrid(document.getElementById('char-search').value, null);
  });

  document.querySelectorAll('.bg-swatch[data-layout]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.bg-swatch[data-layout]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active'); state.layout = btn.dataset.layout; drawCard();
    });
  });

  const bgColorRow   = document.getElementById('bg-color-row');
  const bgColorInput = document.getElementById('bg-color-input');
  document.querySelectorAll('.bg-swatch[data-bg]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.bg-swatch[data-bg]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active'); state.background = btn.dataset.bg;
      bgColorRow.style.display = state.background === 'custom' ? 'flex' : 'none';
      drawCard();
    });
  });
  bgColorInput.addEventListener('input', e => { state.customColor = e.target.value; drawCard(); });

  // Color tint slider — only meaningful once an archive background image is
  // loaded (it controls the element-color gradient drawn on top of it).
  const bgOpacityRow   = document.getElementById('bg-opacity-row');
  const bgOpacityInput = document.getElementById('bg-opacity-input');
  const bgOpacityValue = document.getElementById('bg-opacity-value');
  function updateBgOpacityRow() {
    bgOpacityRow.style.display = arcBgImg ? 'flex' : 'none';
  }
  bgOpacityInput.addEventListener('input', e => {
    const pct = parseInt(e.target.value, 10);
    state.bgColorOpacity = pct / 100;
    bgOpacityValue.textContent = pct + '%';
    drawCard();
  });

  document.querySelectorAll('.bg-swatch[data-pattern]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.bg-swatch[data-pattern]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active'); state.pattern = btn.dataset.pattern; drawCard();
    });
  });

  document.querySelectorAll('.bg-swatch[data-font]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.bg-swatch[data-font]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active'); state.nameFont = btn.dataset.font; drawCard();
    });
  });

  document.getElementById('name-input').addEventListener('input', e => { state.customName = e.target.value; drawCard(); });
  document.getElementById('show-name').addEventListener('change', e => { state.showName = e.target.checked; drawCard(); });
  document.getElementById('show-attack').addEventListener('change', e => {
    state.showAttack = e.target.checked;
    document.getElementById('attack-fields').classList.toggle('hidden', !e.target.checked);
    drawCard();
  });
  document.getElementById('show-element').addEventListener('change', e => { state.showElement = e.target.checked; drawCard(); });
  document.getElementById('show-logo').addEventListener('change', e => { state.showLogo = e.target.checked; drawCard(); });
  document.getElementById('attack-name').addEventListener('input', e => { state.attackName = e.target.value; drawCard(); });
  document.getElementById('attack-damage').addEventListener('input', e => { state.attackDamage = e.target.value; drawCard(); });
  document.getElementById('attack-desc').addEventListener('input', e => { state.attackDesc = e.target.value; drawCard(); });

  document.getElementById('custom-img').addEventListener('change', async e => {
    const file = e.target.files[0]; if (!file) return;
    const reader = new FileReader();
    reader.onload = async ev => {
      charImg = await tryLoad(ev.target.result);
      charImgIsArt = true;
      if (charImg) { usingCustomImg = true; resetArtTransform(); document.getElementById('custom-indicator').style.display = 'block'; document.getElementById('export-btn').disabled = false; drawCard(); }
    };
    reader.readAsDataURL(file);
  });

  document.getElementById('arc-clear').addEventListener('click', () => {
    arcBgImg = null; arcDetailImg = null; arcArtImg = null; arcAttackIconImg = null;
    arcBgUrl = null; arcDetailUrl = null; arcArtUrl = null; arcAttackIconUrl = null;
    resetArtTransform();
    updateBgOpacityRow();
    document.querySelectorAll('.arc-thumb').forEach(t => t.classList.remove('selected'));
    drawCard();
  });

  document.getElementById('clear-custom').addEventListener('click', async () => {
    document.getElementById('custom-img').value = ''; document.getElementById('custom-indicator').style.display = 'none'; usingCustomImg = false;
    resetArtTransform();
    if (state.characterName) { const c = CHARS.find(c => c.name === state.characterName); if (c) charImg = await loadCharImg(c.name); }
    else charImg = null;
    drawCard();
  });

  document.getElementById('export-btn').addEventListener('click', () => {
    const slug = (state.customName.trim() || state.characterName || 'skylander').toLowerCase().replace(/[^a-z0-9]+/g, '-');
    const a = document.createElement('a'); a.download = `skylanders-nfc-${slug}.png`; a.href = canvas.toDataURL('image/png'); a.click();
  });

  // Zeroes the user's pan/zoom on the character art back to centered/
  // default fit. Does not redraw — every call site below already calls
  // drawCard() right after, whether directly or via an existing chain.
  function resetArtTransform() {
    state.artOffsetX = 0;
    state.artOffsetY = 0;
    state.artZoom = 1;
  }
  document.getElementById('reset-art-btn').addEventListener('click', () => { resetArtTransform(); drawCard(); });

  // ── Archive art paging: left/right arrows overlaid on the card preview step
  // straight through the character's tagged archive images, applying each one
  // as the active card art immediately (paging *is* selecting — no separate
  // "open" step or lightbox). loadArchivePickers() preloads every tagged image
  // into arcImgCache up front (mirroring how the base charImg loads on
  // selection) so each step renders instantly from cache.
  function charArchiveImages() {
    if (!archiveIndex || !state.characterName) return [];
    const all = (archiveIndex.byCharacter || {})[state.characterName.toLowerCase()] || [];
    const showAll = document.getElementById('arc-show-all')?.checked ?? false;
    return all.filter(im =>
      !(im.anns || []).includes('attack') && (showAll || im.featured !== false)
    );
  }

  const browseArrowsEl = document.getElementById('browse-arrows');
  const browsePrevBtn  = document.getElementById('browse-prev');
  const browseNextBtn  = document.getElementById('browse-next');

  function pageArchiveArt(delta) {
    const images = charArchiveImages();
    if (images.length < 2) return;
    let idx = images.findIndex(img => img.url === arcArtUrl);
    idx = idx < 0 ? 0 : (idx + delta + images.length) % images.length;
    document.querySelectorAll('#arc-art-gallery .arc-thumb')[idx]?.click();
  }
  browsePrevBtn.addEventListener('click', () => pageArchiveArt(-1));
  browseNextBtn.addEventListener('click', () => pageArchiveArt(1));

  // ── Art pan & zoom: drag to move, scroll wheel to scale ───────────────────
  // Only active when the pointer is within the currently active layout's
  // art panel (tracked by drawArtPanel into lastArtPanelRect every redraw).
  // Free dragging/zooming needs no bounds-checking — the panel (and the
  // card itself) are already clipped, so overflow is cropped for free.
  function clientToCardSpace(clientX, clientY) {
    const rect = canvas.getBoundingClientRect();
    return {
      x: (clientX - rect.left) * (CARD_W / rect.width),
      y: (clientY - rect.top)  * (CARD_H / rect.height),
    };
  }
  function insideArtPanel(cardX, cardY) {
    if (!lastArtPanelRect) return false;
    const { x, y, w, h } = lastArtPanelRect;
    return cardX >= x && cardX <= x + w && cardY >= y && cardY <= y + h;
  }

  let artDrag = null; // { pointerId, startClientX, startClientY, startOffsetX, startOffsetY }
  let artDragRaf = null;

  canvas.addEventListener('pointerdown', e => {
    const p = clientToCardSpace(e.clientX, e.clientY);
    if (!insideArtPanel(p.x, p.y)) return;
    artDrag = {
      pointerId: e.pointerId,
      startClientX: e.clientX, startClientY: e.clientY,
      startOffsetX: state.artOffsetX, startOffsetY: state.artOffsetY,
    };
    canvas.setPointerCapture(e.pointerId);
  });

  canvas.addEventListener('pointermove', e => {
    if (!artDrag || e.pointerId !== artDrag.pointerId) return;
    const rect = canvas.getBoundingClientRect();
    const scaleX = CARD_W / rect.width, scaleY = CARD_H / rect.height;
    state.artOffsetX = artDrag.startOffsetX + (e.clientX - artDrag.startClientX) * scaleX;
    state.artOffsetY = artDrag.startOffsetY + (e.clientY - artDrag.startClientY) * scaleY;
    if (!artDragRaf) artDragRaf = requestAnimationFrame(() => { artDragRaf = null; drawCard(); });
  });

  function endArtDrag(e) {
    if (artDrag && e.pointerId === artDrag.pointerId) artDrag = null;
  }
  canvas.addEventListener('pointerup', endArtDrag);
  canvas.addEventListener('pointercancel', endArtDrag);

  const ART_ZOOM_MIN = 0.3, ART_ZOOM_MAX = 4, ART_ZOOM_STEP = 1.08;
  canvas.addEventListener('wheel', e => {
    const p = clientToCardSpace(e.clientX, e.clientY);
    if (!insideArtPanel(p.x, p.y)) return;
    e.preventDefault();
    const factor = e.deltaY < 0 ? ART_ZOOM_STEP : 1 / ART_ZOOM_STEP;
    state.artZoom = Math.min(ART_ZOOM_MAX, Math.max(ART_ZOOM_MIN, state.artZoom * factor));
    drawCard();
  }, { passive: false });

  // ── Init: wait for fonts before first draw ─────────────────────────────────
  (async () => {
    await Promise.allSettled([
      document.fonts.load("68px 'Bebas Neue'"),
      document.fonts.load("700 60px 'Rajdhani'"),
      document.fonts.load("68px 'Critters'"),
      document.fonts.load("700 68px 'Comic Neue'"),
      document.fonts.load("700 68px 'Caveat'"),
      document.fonts.load("700 68px 'Orbitron'"),
      document.fonts.load("600 68px 'Jost'"),
      document.fonts.load("700 68px 'Cabin'"),
      document.fonts.load("600 68px 'Fredoka'"),
      document.fonts.load("68px 'Boogaloo'"),
      document.fonts.load("68px 'Righteous'"),
      document.fonts.load("68px 'Creepster'"),
    ]);
    buildGrid();
    drawCard();

    // Pre-load a posed 3D model snapshot from the archive character profile viewer
    {
      const artData  = sessionStorage.getItem('nfc-card-custom-art');
      const charName = sessionStorage.getItem('nfc-card-char-name');
      sessionStorage.removeItem('nfc-card-custom-art');
      sessionStorage.removeItem('nfc-card-char-name');
      if (artData && charName) {
        const match = CHARS.find(c => c.name === charName);
        if (match) await selectCharacter(match);
        const img = await tryLoad(artData);
        if (img) {
          charImg = img;
          // Transparent character cutout (posed 3D render), not a full-bleed
          // painted illustration — gets the contain-fit + glow treatment
          // drawArtPanel uses for in-game cutouts, not the cover-fit one.
          charImgIsArt = false;
          usingCustomImg = true;
          resetArtTransform();
          document.getElementById('custom-indicator').style.display = 'block';
          document.getElementById('export-btn').disabled = false;
          drawCard();
        }
      }
    }

    // Pre-load background/detail pickers immediately (no character needed)
    fetchArchiveIndex().then(index => {
      if (!index) return;
      const bgGallery = document.getElementById('arc-bg-gallery');
      const detailGallery = document.getElementById('arc-detail-gallery');
      buildArcGallery(bgGallery, document.getElementById('arc-bg-status'), index.backgrounds || [], null,
        (url, img) => { arcBgUrl = url; arcBgImg = img; updateBgOpacityRow(); });
      buildArcGallery(detailGallery, document.getElementById('arc-detail-status'), index.details || [], null,
        (url, img) => { arcDetailUrl = url; arcDetailImg = img; });
    });
  })();
</script>
