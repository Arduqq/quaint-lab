  const canvas = document.getElementById("canvas");
  const ctx = canvas.getContext("2d");
  
  const currentSelection = {
    background: "null",
    skin: "null",
    base: "base",
    clothes: "null",
    accessory: "null",
    hair: "null",
    eyes: "null",
    mouth: "null",
    beard: "null"
  };

  const imageCache = {};

  async function loadImage(category, name) {
    const path = `/images/qeycard/${category}/${name}.png`;
    if (imageCache[path]) return imageCache[path];
    
    return new Promise(resolve => {
      const img = new Image();
      img.src = path;
      img.onload = () => {
        imageCache[path] = img;
        resolve(img);
      };
      img.onerror = () => resolve(null);
    });
  }

  async function redraw() {
    ctx.clearRect(0, 0, 500, 500);
    const layers = ["background", "skin", "base", "clothes", "accessory", "beard", "mouth", "eyes", "hair"];
    
    for (const layer of layers) {
      const name = currentSelection[layer];
      if (name && name !== "null") {
        const img = await loadImage(layer, name);
        if (img) ctx.drawImage(img, 0, 0, 500, 500);
      }
    }
  }

  function loadAssets() {
    for (const [category, items] of Object.entries(assets)) {
      const container = document.getElementById(category);
      if (!container) continue;

      items.forEach(item => {
        const label = document.createElement('label');
        label.dataset.tooltip = item.name !== "null" ? item.name : "None";
        label.style.backgroundImage = `url(/images/qeycard/${category}/${item.name}.png)`;
        
        const input = document.createElement('input');
        input.type = "radio";
        input.name = category;
        input.value = item.name;
        if (currentSelection[category] === item.name) input.checked = true;

        const highlight = document.createElement('span');

        label.appendChild(input);
        label.appendChild(highlight);
        
        input.addEventListener('change', () => {
          currentSelection[category] = item.name;
          redraw();
        });
        
        container.appendChild(label);
      });
    }
  }

  function randomize() {
    for (const category of Object.keys(assets)) {
      if (category === "base") continue;
      const items = assets[category];
      const randomItem = items[Math.floor(Math.random() * items.length)];
      currentSelection[category] = randomItem.name;
      
      const input = document.querySelector(`input[name="${category}"][value="${randomItem.name}"]`);
      if (input) input.checked = true;
    }
    redraw();
  }

  function save() {
    const link = document.createElement('a');
    link.download = 'qeycard.png';
    link.href = canvas.toDataURL('image/png');
    link.click();
  }

  loadAssets();
  redraw();

  document.getElementById("randomize").addEventListener('click', randomize);
  document.getElementById("save").addEventListener('click', save);
</script>
