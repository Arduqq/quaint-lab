---
title: "The Qeycard Maker"
layout: base.njk
permalink: "qeycard/"
---

<section class="qey-decorator">
  <div class="qey-header text-center">
    <h2>{{ title }}</h2>
    <p><strong>Qeycard Maker v1.2</strong> — Click together your own lab portrait. Right-click or hold down the final picture to save it. No credits needed!</p>
  </div>

  <div class="qey-container">
    <!-- Left Column -->
    <div class="qey-column side-left">
      <details open class="option-group">
        <summary><h3>Background</h3></summary>
        <div id="background" class="option-grid"></div>
      </details>

      <details open class="option-group">
        <summary><h3>Skin</h3></summary>
        <div id="skin" class="option-grid"></div>
      </details>

      <details class="option-group">
        <summary><h3>Clothes</h3></summary>
        <div id="clothes" class="option-grid"></div>
      </details>

      <details class="option-group">
        <summary><h3>Accessory</h3></summary>
        <div id="accessory" class="option-grid"></div>
      </details>
    </div>

    <!-- Center Column -->
    <div class="qey-column main-preview">
      <div class="canvas-wrapper">
        <canvas id="canvas" width="500" height="500"></canvas>
      </div>
      <div class="action-buttons">
        <button id="randomize" class="btn primary" data-tooltip="Completely randomize your Qeycard">✨ Randomize All</button>
        <button id="save" class="btn" data-tooltip="Download your Qeycard">💾 Save Image</button>
      </div>
      
      <div class="changelog mt-4">
        <p><small><strong>v1.2 PRISM Update:</strong> Added 12 natural, 6 hair styles, and Gecko accessories! 🌈</small></p>
        <p><small><strong>v1.1 Broccoli Update:</strong> Added planty backgrounds, beards, clothes, and more! 🥦</small></p>
      </div>
    </div>

    <!-- Right Column -->
    <div class="qey-column side-right">
      <details open class="option-group">
        <summary><h3>Hair</h3></summary>
        <div id="hair" class="option-grid"></div>
      </details>

      <details open class="option-group">
        <summary><h3>Eyes</h3></summary>
        <div id="eyes" class="option-grid"></div>
      </details>

      <details class="option-group">
        <summary><h3>Mouth</h3></summary>
        <div id="mouth" class="option-grid"></div>
      </details>

      <details class="option-group">
        <summary><h3>Beard</h3></summary>
        <div id="beard" class="option-grid"></div>
      </details>
    </div>
  </div>
</section>

<style>
  .qey-decorator {
    padding: var(--padding-unit);
    background: var(--section-background-color);
    border: 2px solid var(--border-color);
    border-radius: var(--border-radius);
    color: var(--text-color);
    max-width: 1400px;
    margin: 0 auto;
  }

  .qey-header {
    text-align: center;
    margin-bottom: 2rem;
    border-bottom: 1px dashed var(--border-color);
    padding-bottom: 1rem;
  }

  /* Desktop Grid Layout */
  .qey-container {
    display: grid;
    grid-template-columns: 1fr 520px 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .qey-column {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0; /* Prevents grid items from overflowing */
  }

  .main-preview {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    position: sticky;
    top: 1rem;
  }

  .canvas-wrapper {
    background: #222;
    padding: 10px;
    border: 4px solid var(--border-color);
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    width: 100%;
    max-width: 520px;
    box-sizing: border-box;
  }

  #canvas {
    width: 100%;
    height: auto;
    display: block;
    background: #fff;
    image-rendering: pixelated;
  }

  .option-group {
    background: rgba(0,0,0,0.03);
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 8px;
    overflow: hidden;
  }

  .option-group summary {
    padding: 0.75rem 1rem;
    cursor: pointer;
    background: rgba(0,0,0,0.05);
    font-weight: bold;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: background 0.2s;
  }

  .option-group summary:hover {
    background: rgba(0,0,0,0.08);
  }

  .option-group summary::-webkit-details-marker {
    display: none;
  }

  .option-group summary::before {
    content: '▶';
    font-size: 0.7rem;
    transition: transform 0.2s;
  }

  .option-group[open] summary::before {
    transform: rotate(90deg);
  }

  .option-group h3 {
    margin: 0;
    font-size: 0.95rem;
    text-transform: uppercase;
    display: inline;
  }

  .option-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(60px, 1fr));
    gap: 0.4rem;
    padding: 0.8rem;
    max-height: 350px;
    overflow-y: auto;
  }

  /* Custom checkbox style using the asset as background */
  .option-grid label {
    display: block;
    aspect-ratio: 1;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    cursor: pointer;
    background-size: cover;
    background-position: center;
    image-rendering: pixelated;
    transition: all 0.15s;
    background-color: #fff;
    position: relative;
  }

  .option-grid label:hover {
    transform: scale(1.08);
    border-color: var(--highlight-color);
    z-index: 1;
  }

  .option-grid input {
    display: none;
  }

  .option-grid input:checked + span {
    position: absolute;
    inset: -2px;
    border: 2.5px solid var(--highlight-color);
    border-radius: 4px;
    pointer-events: none;
  }

  .btn {
    padding: 0.7rem 1.2rem;
    border: 2px solid var(--border-color);
    background: var(--section-background-color);
    color: var(--text-color);
    font-family: var(--main-font);
    font-weight: bold;
    cursor: pointer;
    border-radius: 8px;
    transition: all 0.15s;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    user-select: none;
  }

  .btn:hover {
    transform: translateY(-2px);
    background: var(--highlight-color);
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  }

  .btn.primary {
    background: var(--highlight-color);
  }

  .action-buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .mt-4 { margin-top: 1rem; }
  .text-center { text-align: center; }

  /* Responsive Adjustments */
  @media (max-width: 1200px) {
    .qey-container {
      grid-template-columns: 1fr 1fr;
    }
    .main-preview {
      grid-column: span 2;
      position: static;
      order: -1;
      margin-bottom: 2rem;
    }
  }

  @media (max-width: 768px) {
    .qey-container {
      grid-template-columns: 1fr;
    }
    .main-preview {
      grid-column: span 1;
    }
    .qey-decorator {
      padding: 1rem;
    }
  }
</style>

