  <fieldset id="appearance-switcher" class="theme-picker">
    <legend><h3>Themes</h3></legend>
    
    <div class="theme-list">
      <label class="theme-option" data-theme-option="contrast">
        <input type="radio" name="theme" value="contrast">
        <span class="theme-name">Contrast</span>
      </label>

      <label class="theme-option" data-theme-option="woodland5">
        <input type="radio" name="theme" value="woodland5">
        <span class="theme-name">Woodland</span>
      </label>

      <label class="theme-option" data-theme-option="chaos">
        <input type="radio" name="theme" value="chaos">
        <span class="theme-name">Chaos</span>
      </label>

      <label class="theme-option" data-theme-option="ink">
        <input type="radio" name="theme" value="ink">
        <span class="theme-name">Ink</span>
      </label>

      <label class="theme-option" data-theme-option="juliet">
        <input type="radio" name="theme" value="juliet">
        <span class="theme-name">Juliet</span>
      </label>

      <label class="theme-option" data-theme-option="plus100">
        <input type="radio" name="theme" value="plus100">
        <span class="theme-name">Plus100</span>
      </label>

      <label class="theme-option" data-theme-option="sashimi">
        <input type="radio" name="theme" value="sashimi">
        <span class="theme-name">Sashimi</span>
      </label>

      <label class="theme-option" data-theme-option="sunsetred">
        <input type="radio" name="theme" value="sunsetred">
        <span class="theme-name">Sunset Red</span>
      </label>

      <label class="theme-option" data-theme-option="twilight">
        <input type="radio" name="theme" value="twilight">
        <span class="theme-name">Twilight</span>
      </label>
    </div>

    <small class="section-label">Raumfahrt Destination</small>
    <div class="destination-list">
      <label class="destination-option" data-destination="none" data-tooltip="None">
        <input type="radio" name="destination" value="none">
        <div class="none-icon" style="display: flex; align-items: center; justify-content: center; border-radius: 50%; background-color: var(--background-color); width: 100%; height: 100%">∅</div>
      </label>

      <label class="destination-option" data-destination="sofia" data-tooltip="Sofia">
        <input type="radio" name="destination" value="sofia">
        <img src="/images/destinations/sofia.gif" alt="Sofia">
      </label>

      <label class="destination-option" data-destination="fjoron" data-tooltip="Fjoron">
        <input type="radio" name="destination" value="fjoron">
        <img src="/images/destinations/fjoron.gif" alt="Fjoron">
      </label>

      <label class="destination-option" data-destination="larva" data-tooltip="Larva">
        <input type="radio" name="destination" value="larva">
        <img src="/images/destinations/larva.gif" alt="Larva">
      </label>

      <label class="destination-option" data-destination="even-thicket" data-tooltip="Even Thicket">
        <input type="radio" name="destination" value="even-thicket">
        <img src="/images/destinations/even-thicket.gif" alt="Even Thicket">
      </label>

      <label class="destination-option" data-destination="first-mine" data-tooltip="First Mine">
        <input type="radio" name="destination" value="first-mine">
        <img src="/images/destinations/first-mine.gif" alt="First Mine">
      </label>
    </div>
    <div class="zone-readout" id="zone-readout" aria-live="polite">
      [currently on:: <span id="zone-name">—</span>]
    </div>
  </fieldset>

  <script>
    (function(){
      const root = document.documentElement;
      const appearanceContainer = document.querySelector('#appearance-switcher');
      if (!appearanceContainer) return;

      // --- Theme Logic ---
      const themeRadios = appearanceContainer.querySelectorAll('input[name="theme"]');
      const themeLabels = appearanceContainer.querySelectorAll('.theme-option');
      const savedTheme = localStorage.getItem('theme') || root.getAttribute('data-theme') || 'contrast';

      function setTheme(theme) {
        root.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
        themeRadios.forEach(r => r.checked = (r.value === theme));
        themeLabels.forEach(l => {
          if (l.getAttribute('data-theme-option') === theme) l.classList.add('active');
          else l.classList.remove('active');
        });
      }

      setTheme(savedTheme);
      themeRadios.forEach(radio => {
        radio.addEventListener('change', (e) => setTheme(e.target.value));
      });

      // --- Destination Logic ---
      const destMapping = {
        'none': null,
        'sofia': 'sofia.webp',
        'fjoron': 'fjoron.webp',
        'larva': 'larva.webp',
        'even-thicket': 'even-thicket.webp',
        'first-mine': 'first-mine.webp'
      };
      const zoneNames = {
        'none': '—',
        'sofia': 'Sofia',
        'fjoron': 'Fjoron',
        'larva': 'Larva',
        'even-thicket': 'Even Thicket',
        'first-mine': 'First Mine'
      };
      const destOptions = appearanceContainer.querySelectorAll('.destination-option');
      const zoneNameEl = document.getElementById('zone-name');

      function setDestination(name, skipBackground = false) {
        if (!name || !(name in destMapping)) name = 'none';

        if (!skipBackground) {
          const mapping = destMapping[name];
          if (mapping) {
            const url = '/images/destinations/' + mapping;
            root.style.setProperty('--destination-image', `url('${url}')`);
            root.classList.remove('no-destination');
          } else {
            root.style.setProperty('--destination-image', 'none');
            root.classList.add('no-destination');
          }
          if (zoneNameEl) zoneNameEl.textContent = zoneNames[name] ?? '—';
        }

        localStorage.setItem('destination', name);

        destOptions.forEach(o => {
          const isMatch = o.getAttribute('data-destination') === name;
          o.classList.toggle('active', isMatch);
          const inp = o.querySelector('input[name="destination"]');
          if (inp) inp.checked = isMatch;
        });
      }

      const savedDest = localStorage.getItem('destination') || 'none';
      setDestination(savedDest);

      destOptions.forEach(opt => {
        opt.addEventListener('click', (e) => {
          const name = opt.getAttribute('data-destination');
          if (!name || root.classList.contains('is-flying')) return;
          
          // Immediate UI feedback (selection highlight)
          setDestination(name, true);

          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || name === 'none') {
            setDestination(name);
            return;
          }

          root.classList.add('is-flying');
          setTimeout(() => {
            // Actual background swap while in flight
            setDestination(name);
            root.classList.add('is-landing');
            void root.offsetWidth;
            root.classList.remove('is-flying', 'is-landing');
          }, 800);
        });
      });
    })();
  </script>
