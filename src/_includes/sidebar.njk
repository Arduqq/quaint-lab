<aside>
  <h1>A Quaint Lab</h1>
  <div class="site-logo" role="img">
    <div id="pet-chamber" class="pet-chamber">
      <div id="event-log" class="event-log">Observing...</div>
      <div id="pet-display" class="pet-display"></div>
      <div class="imood-link">
        <a href="https://www.imood.com/users/Lyonid" target="_blank">
          <img src="https://moods.imood.com/display/uname-Lyonid/imood.gif" alt="The current mood of Lyonid at www.imood.com">
        </a>
      </div>
    </div>
  </div>

  <script>
    const petList = {{ pet_list | dump | safe }};
    const petEvents = {{ pet_events | dump | safe }};

    function initPetChamber() {
      const display = document.getElementById('pet-display');
      const log = document.getElementById('event-log');
      
      const rand = Math.random();
      
      if (rand < 0.2) { // 20% chance for empty
        const eventTemplate = petEvents.empty[Math.floor(Math.random() * petEvents.empty.length)];
        log.textContent = eventTemplate;
        display.innerHTML = '';
      } else if (rand < 0.6 && petList.length >= 2) { // 40% chance for duo
        const petAIndex = Math.floor(Math.random() * petList.length);
        let petBIndex = Math.floor(Math.random() * petList.length);
        while (petBIndex === petAIndex) {
          petBIndex = Math.floor(Math.random() * petList.length);
        }
        
        const petA = petList[petAIndex];
        const petB = petList[petBIndex];
        
        const eventTemplate = petEvents.duo[Math.floor(Math.random() * petEvents.duo.length)];
        log.textContent = eventTemplate.replace('{petA}', petA.name).replace('{petB}', petB.name);
        
        display.innerHTML = `
          <img src="/images/artwork/${petA.image}" class="alive calm" style="width: 60px;">
          <img src="/images/artwork/${petB.image}" class="alive nervous" style="width: 60px;">
        `;
      } else { // 40% chance for solo
        const pet = petList[Math.floor(Math.random() * petList.length)];
        const eventTemplate = petEvents.solo[Math.floor(Math.random() * petEvents.solo.length)];
        log.textContent = eventTemplate.replace('{pet}', pet.name);
        
        display.innerHTML = `<img src="/images/artwork/${pet.image}" class="alive eerie" style="width: 80px;">`;
      }
    }

    document.addEventListener('DOMContentLoaded', initPetChamber);
  </script>
  
