{% if screenshots %}
  <section class="screenshot-gallery">
    <h3>Screenshots</h3>
    <div class="illustration-gallery">
      {% for screenshot in screenshots %}
        <a class="illustration" href="{{ screenshot }}" target="_blank">
          <img src="{{ screenshot }}" alt="Screenshot for {{ posttitle }}">
        </a>
      {% endfor %}
    </div>
  </section>

  <style>
    .screenshot-gallery {
      margin-top: 2rem;
      border-top: 1px dashed var(--border-color);
      padding-top: 1rem;
    }
    .screenshot-gallery h3 {
      margin-bottom: 1.5rem;
      text-align: center;
    }
    .screenshot-gallery .illustration img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border: 1px solid var(--border-color);
    }
  </style>
{% endif %}
